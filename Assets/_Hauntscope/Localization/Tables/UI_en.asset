  - m_Id: 4815341386858515
    m_Localized: BUREAU RADIO
    m_Metadata:
      m_Items: []
  - m_Id: 4815341386858516
    m_Localized: 'Let the Night Bureau reach you: we''ll tell you when your daily
      ration is ready and when ghosts stir at your address. Never at night.'
    m_Metadata:
      m_Items: []
