    m_Metadata:
      m_Items: []
  - m_Id: 457669686460429
    m_Localized: New orders in {0:00}:{1:00}:{2:00}
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460430
    m_Localized: One free replace a day, and one more for an ad. Orders done but
      not claimed by midnight are paid anyway.
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460431
    m_Localized: ORDER DONE
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460432
    m_Localized: 'ORDERS DONE: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460433
    m_Localized: The pay waits in CONTRACTS
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460434
    m_Localized: "Catch ghosts \xD7{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460435
    m_Localized: "Collect pickups in the room \xD7{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460436
    m_Localized: "Take photos of 1 star or more \xD7{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460437
    m_Localized: "Hold the beam on a stunned ghost \xD7{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460438
    m_Localized: Take a 3-star photo
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460439
    m_Localized: Drive a ghost out of its hiding spot
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460440
    m_Localized: Catch a ghost from closer than 1 m
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460441
    m_Localized: Pick up a cursed case (lens only)
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460442
    m_Localized: Catch a ghost with no spare battery or boosters
    m_Metadata:
      m_Items: []
