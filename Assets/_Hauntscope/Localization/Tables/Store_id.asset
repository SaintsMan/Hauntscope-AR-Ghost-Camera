  m_TableData:
  - m_Id: 1129709568
    m_Localized: M1 STANDAR
    m_Metadata:
      m_Items: []
  - m_Id: 1146486784
    m_Localized: Perlengkapan standar agensi. Andal, tidak lebih.
    m_Metadata:
      m_Items: []
  - m_Id: 1146486785
    m_Localized: W2 SOROT
    m_Metadata:
      m_Items: []
  - m_Id: 1146486786
    m_Localized: Lingkaran lebar yang memaafkan tangan gemetar. Tangkapan memudar
      dua kali lebih lambat.
    m_Metadata:
      m_Items: []
  - m_Id: 1146486787
    m_Localized: T3 PENGIKAT
    m_Metadata:
      m_Items: []
  - m_Id: 1146486788
    m_Localized: 'Mencengkeram hantu: setengah kecepatan di dalam sinar, tangkapan
      +20%.'
    m_Metadata:
      m_Items: []
  - m_Id: 1146486789
    m_Localized: P4 TOMBAK FASE
    m_Metadata:
      m_Items: []
  - m_Id: 1146486790
    m_Localized: Menangkap 60% lebih cepat dan menahan hantu yang menghilang. Lingkaran
      sempit.
    m_Metadata:
      m_Items: []
  - m_Id: 1146486791
    m_Localized: BATERAI CADANGAN
    m_Metadata:
      m_Items: []
  - m_Id: 1146486792
    m_Localized: +50% daya. Pasang kapan saja saat berburu, atau saat baterai habis.
    m_Metadata:
      m_Items: []
  - m_Id: 1146486793
    m_Localized: PENGUAT EMF
    m_Metadata:
      m_Items: []
  - m_Id: 1146486794
    m_Localized: EMF menjangkau 50% lebih jauh dan panah menunjuk ke sumbernya. Satu
      perburuan.
    m_Metadata:
      m_Items: []
  - m_Id: 1146486795
    m_Localized: LENSA FOKUS
    m_Metadata:
      m_Items: []
  - m_Id: 1146486796
    m_Localized: Lensa Hantu hanya menguras setengah baterai. Satu perburuan.
    m_Metadata:
      m_Items: []
  - m_Id: 1146486797
    m_Localized: GARIS GARAM
    m_Metadata:
      m_Items: []
  - m_Id: 1146486798
    m_Localized: Hantu bergerak 35% lebih lambat di atas lantai bergaram. Satu perburuan.
    m_Metadata:
      m_Items: []
  - m_Id: 4473458026479616
    m_Localized: VERSI LENGKAP
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451136
    m_Localized: Tanpa iklan, hadiah video langsung, +1.500 ektoplasma, dan laser
      emas A0 AURUM.
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451137
    m_Localized: PAKET AGEN BARU
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451138
    m_Localized: 1.000 ektoplasma, laser T3 PENGIKAT, 3 tiap penguat, dan 3 baterai
      cadangan.
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451139
    m_Localized: TABUNG EKTOPLASMA
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451140
    m_Localized: 500 ektoplasma untuk laser dan perlengkapan.
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451141
    m_Localized: TOPLES EKTOPLASMA
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451142
    m_Localized: 1.800 ektoplasma, sudah termasuk bonus +20%.
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451143
    m_Localized: TONG EKTOPLASMA
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451144
    m_Localized: 3.500 ektoplasma, sudah termasuk bonus +40%.
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451145
    m_Localized: BRANKAS EKTOPLASMA
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451146
    m_Localized: 8.000 ektoplasma, sudah termasuk bonus +60%. Paling hemat.
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451147
    m_Localized: PAKET LAPANGAN
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451148
    m_Localized: 3 tiap penguat (penguat EMF, lensa fokus, garis garam) dan 3 baterai
      cadangan.
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451149
    m_Localized: S5 ARWAH
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451150
    m_Localized: Sinar putih yang jadi sian saat mengunci. Menangkap 30% lebih cepat,
      memperlambat hantu.
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451151
    m_Localized: S5 ARWAH
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451152
    m_Localized: Sinar putih yang terkunci biru toska. Menangkap 30% lebih cepat
      dan memperlambat hantu.
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451153
    m_Localized: A0 AURUM
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451154
    m_Localized: 'Sinar emas versi lengkap: menangkap 35% lebih cepat, cincin lebih
      lebar, turun lebih lambat.'
    m_Metadata:
      m_Items: []
  references:
    version: 2
