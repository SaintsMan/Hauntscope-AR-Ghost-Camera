  m_TableData:
  - m_Id: 1129709568
    m_Localized: M1 STANDARD
    m_Metadata:
      m_Items: []
  - m_Id: 1146486784
    m_Localized: Agency standard issue. Reliable, and nothing more.
    m_Metadata:
      m_Items: []
  - m_Id: 1146486785
    m_Localized: W2 FLOODLIGHT
    m_Metadata:
      m_Items: []
  - m_Id: 1146486786
    m_Localized: A wide ring that forgives a shaky hand. Capture fades half as fast.
    m_Metadata:
      m_Items: []
  - m_Id: 1146486787
    m_Localized: T3 TETHER
    m_Metadata:
      m_Items: []
  - m_Id: 1146486788
    m_Localized: 'Grips the ghost: half speed in the beam, capture +20%.'
    m_Metadata:
      m_Items: []
  - m_Id: 1146486789
    m_Localized: P4 PHASE LANCE
    m_Metadata:
      m_Items: []
  - m_Id: 1146486790
    m_Localized: Captures 60% faster and holds ghosts that vanish. Narrow ring.
    m_Metadata:
      m_Items: []
  - m_Id: 1146486791
    m_Localized: SPARE BATTERY
    m_Metadata:
      m_Items: []
  - m_Id: 1146486792
    m_Localized: +50% charge. Swap it in any time during a hunt, or when the battery
      dies.
    m_Metadata:
      m_Items: []
  - m_Id: 1146486793
    m_Localized: EMF AMPLIFIER
    m_Metadata:
      m_Items: []
  - m_Id: 1146486794
    m_Localized: EMF reaches 50% farther and an arrow points to the source. One hunt.
    m_Metadata:
      m_Items: []
  - m_Id: 1146486795
    m_Localized: FOCUS LENS
    m_Metadata:
      m_Items: []
  - m_Id: 1146486796
    m_Localized: The Ghost Lens drains half as much battery. One hunt.
    m_Metadata:
      m_Items: []
  - m_Id: 1146486797
    m_Localized: SALT LINE
    m_Metadata:
      m_Items: []
  - m_Id: 1146486798
    m_Localized: Ghosts move 35% slower over a salted floor. One hunt.
    m_Metadata:
      m_Items: []
  - m_Id: 4473458026479616
    m_Localized: FULL VERSION
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451136
    m_Localized: No ads, instant video rewards, +1,500 ectoplasm and the gold laser
      A0 AURUM.
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451137
    m_Localized: ROOKIE KIT
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451138
    m_Localized: 1,000 ectoplasm, the T3 TETHER laser, 3 of each booster and 3 spare
      batteries.
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451139
    m_Localized: VIAL OF ECTOPLASM
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451140
    m_Localized: 500 ectoplasm for lasers and gear.
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451141
    m_Localized: JAR OF ECTOPLASM
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451142
    m_Localized: 1,800 ectoplasm, +20% bonus included.
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451143
    m_Localized: BARREL OF ECTOPLASM
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451144
    m_Localized: 3,500 ectoplasm, +40% bonus included.
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451145
    m_Localized: VAULT OF ECTOPLASM
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451146
    m_Localized: 8,000 ectoplasm, +60% bonus included. Best value.
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451147
    m_Localized: FIELD KIT
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451148
    m_Localized: 3 of each booster (EMF amplifier, focus lens, salt line) and 3 spare
      batteries.
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451149
    m_Localized: S5 SPECTRE
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451150
    m_Localized: Ghost-white beam that locks in cyan. Captures 30% faster, slows
      a held ghost.
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451151
    m_Localized: S5 SPECTRE
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451152
    m_Localized: Ghost-white beam that locks in cyan. Captures 30% faster and slows
      a held ghost.
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451153
    m_Localized: A0 AURUM
