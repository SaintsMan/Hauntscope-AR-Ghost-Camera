    m_Localized: 'Fotos en el expediente: {0}. Mejor foto: {1}/3 estrellas. Toca
      la foto para abrirla.'
    m_Metadata:
      m_Items: []
  - m_Id: 415100722085890
    m_Localized: 'Cuentan para desclasificar: {0}/{1} (fotos de {2}+ estrellas).'
    m_Metadata:
      m_Items: []
  - m_Id: 415100722085891
    m_Localized: "\xD7{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 438212909989888
    m_Localized: HORA BRUJA +{0}
    m_Metadata:
