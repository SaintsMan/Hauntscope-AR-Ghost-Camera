  - m_Id: 448606227529728
    m_Localized: "TURNO NOCTURNO \xB7 3 FANTASMAS"
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278464
    m_Localized: "Se abre tras {0} cacer\xEDas"
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278465
    m_Localized: "R\xE9cord: {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278466
    m_Localized: "TURNO {0}/{1} \xB7 \xD7{2:0.#}"
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278467
    m_Localized: SIGUIENTE
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278468
    m_Localized: NUEVO TURNO
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278469
    m_Localized: "TURNO \xD7{0:0.#} +{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278470
    m_Localized: "TURNO NOCTURNO {0}/{1} \xB7 TOTAL DEL TURNO +{2}"
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278471
    m_Localized: "TURNO CERRADO {0}/{0} \xB7 TOTAL DEL TURNO +{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278472
    m_Localized: "TURNO TERMINADO EN {0}/{1} \xB7 TOTAL DEL TURNO +{2}"
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278473
    m_Localized: BONO DE TURNO +{0}
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278474
    m_Localized: BONO DE TURNO +{0} Y {1}
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278475
    m_Localized: "DESCANSO \xB7 TURNO {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278476
    m_Localized: Elige una. Las mejoras duran hasta el final del turno y se acumulan.
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278477
    m_Localized: "Bater\xEDa {0}% \xB7 el pr\xF3ximo fantasma es m\xE1s duro, captura
      \xD7{1:0.#}"
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278478
    m_Localized: EN ESTE TURNO
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278479
    m_Localized: "Lente fr\xEDa"
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278480
    m_Localized: "La lente gasta la bater\xEDa a la mitad de velocidad."
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278481
    m_Localized: Antena potenciada
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278482
    m_Localized: "El EMF llega un 50% m\xE1s lejos y apunta al fantasma."
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278483
    m_Localized: Mano dura
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278484
    m_Localized: "El rayo captura un 25% m\xE1s r\xE1pido."
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278485
    m_Localized: Rayo ancho
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278486
    m_Localized: "El anillo de captura es un 30% m\xE1s ancho."
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278487
    m_Localized: Sal en el bolsillo
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278488
    m_Localized: "Los fantasmas se mueven un 20% m\xE1s lento."
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278489
    m_Localized: "Bater\xEDa nueva"
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278490
    m_Localized: +40% de carga ahora mismo.
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278491
    m_Localized: Casete de repuesto
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278492
    m_Localized: "+2 fotogramas de pel\xEDcula en cada cacer\xEDa que quede del turno."
    m_Metadata:
      m_Items: []
  - m_Id: 457669652905984
    m_Localized: "\xD3RDENES"
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460416
    m_Localized: "\xD3RDENES DE LA AGENCIA"
    m_Metadata:
      m_Items: []
