    m_Localized: '{0}/{1}'
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460422
    m_Localized: +{0}
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460423
    m_Localized: "{0} \xD7{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460424
    m_Localized: pagada
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460425
    m_Localized: COBRAR
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460426
    m_Localized: CAMBIAR
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460427
    m_Localized: HECHA
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460428
    m_Localized: PAGADA
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460429
    m_Localized: "Nuevas \xF3rdenes en {0:00}:{1:00}:{2:00}"
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460430
    m_Localized: "Un cambio gratis al d\xEDa y otro m\xE1s por un anuncio. Las \xF3rdenes
      cumplidas pero sin cobrar se pagan igual a medianoche."
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460431
    m_Localized: ORDEN CUMPLIDA
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460432
    m_Localized: "\xD3RDENES CUMPLIDAS: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460433
    m_Localized: "El pago te espera en \xD3RDENES"
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460434
    m_Localized: "Captura fantasmas \xD7{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460435
    m_Localized: "Recoge hallazgos en el cuarto \xD7{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460436
    m_Localized: "Toma fotos de 1 estrella o m\xE1s \xD7{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460437
    m_Localized: "Mant\xE9n el rayo sobre un fantasma aturdido \xD7{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460438
    m_Localized: Toma una foto de 3 estrellas
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460439
    m_Localized: Saca a un fantasma de su escondite
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460440
    m_Localized: Captura un fantasma a menos de 1 m
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460441
    m_Localized: "Recoge un malet\xEDn maldito (solo con la lente)"
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460442
    m_Localized: "Captura un fantasma sin bater\xEDa de repuesto ni potenciadores"
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460443
    m_Localized: "Captura un fantasma con 50% de carga o m\xE1s"
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460444
    m_Localized: Llega al 3.er fantasma de un turno nocturno
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460445
    m_Localized: 'Captura: {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460446
    m_Localized: Captura un fantasma en 1:30 o menos
    m_Metadata:
      m_Items: []
  - m_Id: 462155494588416
    m_Localized: "RACI\xD3N DIARIA"
    m_Metadata:
      m_Items: []
  - m_Id: 462155528142848
    m_Localized: '{0}'
    m_Metadata:
      m_Items: []
  - m_Id: 462155528142849
    m_Localized: Fotograma {0} de {1}
    m_Metadata:
      m_Items: []
  - m_Id: 462155528142850
    m_Localized: "Un d\xEDa perdido nunca rebobina la cinta"
    m_Metadata:
      m_Items: []
  - m_Id: 462155528142851
    m_Localized: "El pr\xF3ximo fotograma llega ma\xF1ana"
    m_Metadata:
      m_Items: []
  - m_Id: 462155528142852
    m_Localized: RECLAMAR
    m_Metadata:
      m_Items: []
  - m_Id: 462155528142853
    m_Localized: RECLAMADO
    m_Metadata:
      m_Items: []
  - m_Id: 462155528142854
    m_Localized: "\xD7{0} POR UN ANUNCIO"
    m_Metadata:
      m_Items: []
  - m_Id: 462155528142855
    m_Localized: '{0}'
    m_Metadata:
      m_Items: []
  - m_Id: 462155528142856
    m_Localized: "\xD7{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 465765972443136
    m_Localized: "\xA1Se est\xE1 soltando! Mantenlo en el anillo, no lo sueltes."
    m_Metadata:
      m_Items: []
  - m_Id: 465766005997568
    m_Localized: CONSEJO DE AGENTE
    m_Metadata:
      m_Items: []
  - m_Id: 465766005997569
    m_Localized: "Su truco lo dej\xF3 aturdido: \xA1dale con el rayo ahora!"
    m_Metadata:
      m_Items: []
  - m_Id: 465766005997570
    m_Localized: "Ac\xE9rcate: de cerca el rayo carga mucho m\xE1s r\xE1pido."
    m_Metadata:
      m_Items: []
  - m_Id: 465766005997571
    m_Localized: "Est\xE1 en la lente: t\xF3male una foto para su expediente."
    m_Metadata:
      m_Items: []
  - m_Id: 465766005997572
    m_Localized: "Punto fr\xEDo: se esconde cerca. Rodea los muebles y ac\xE9rcate."
    m_Metadata:
      m_Items: []
  - m_Id: 465766005997573
    m_Localized: "No te muevas: vendr\xE1 a ti por su cuenta."
    m_Metadata:
      m_Items: []
  - m_Id: 465766005997574
    m_Localized: "Hora bruja: los fantasmas raros aparecen m\xE1s seguido y cada
      captura paga m\xE1s."
    m_Metadata:
      m_Items: []
  - m_Id: 465766005997575
    m_Localized: "Cada mejora dura hasta el final del turno y se acumula con las
      dem\xE1s. Elige pensando en el pr\xF3ximo fantasma."
    m_Metadata:
      m_Items: []
  - m_Id: 465766005997576
    m_Localized: NUEVO
    m_Metadata:
      m_Items: []
  - m_Id: 465766005997577
    m_Localized: REINICIAR CONSEJOS
    m_Metadata:
      m_Items: []
  - m_Id: 465766005997578
    m_Localized: "LOS CONSEJOS VOLVER\xC1N A APARECER"
    m_Metadata:
      m_Items: []
  - m_Id: 668077995196416
    m_Localized: SPIRIT BOX
    m_Metadata:
      m_Items: []
  - m_Id: 668078058110976
    m_Localized: "\xAB{0}\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 668078058110977
