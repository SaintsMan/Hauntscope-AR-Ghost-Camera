    m_Metadata:
      m_Items: []
  - m_Id: 674327084531712
    m_Localized: NIGHT VISION
    m_Metadata:
      m_Items: []
  - m_Id: 674327084531713
    m_Localized: 'Agensi memberimu night vision: ketuk MODE. Kamu melihat sosok samar
      hantu tanpa menampakkannya, dan ia tak menyadarimu.'
    m_Metadata:
      m_Items: []
  - m_Id: 678718378213376
    m_Localized: TERMAL
    m_Metadata:
      m_Items: []
  - m_Id: 678718466293760
    m_Localized: 'Agensi memberimu kamera termal: ketuk MODE sampai TERMAL. Hantu
      tampak sebagai sosok dingin, bahkan di balik perabot.'
    m_Metadata:
      m_Items: []
  - m_Id: 683306913234944
    m_Localized: SINAR UV
    m_Metadata:
      m_Items: []
  - m_Id: 683307118755840
    m_Localized: 'Agensi memberimu senter UV: ketuk MODE sampai SINAR UV. Ektoplasma
      yang berpendar menunjukkan ke mana hantu pergi. Ikuti jejaknya.'
    m_Metadata:
      m_Items: []
