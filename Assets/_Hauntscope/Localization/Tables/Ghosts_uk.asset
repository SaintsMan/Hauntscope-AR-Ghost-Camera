  m_TableData:
  - m_Id: 34469605408768
    m_Localized: "\u0412\u041E\u0413\u041D\u0418\u041A"
    m_Metadata:
      m_Items: []
  - m_Id: 37744564109312
    m_Localized: "\u041F\u041E\u041B\u0422\u0415\u0420\u0413\u0415\u0419\u0421\u0422"
    m_Metadata:
      m_Items: []
  - m_Id: 37744606052352
    m_Localized: "\u0422\u0406\u041D\u042C"
    m_Metadata:
      m_Items: []
  - m_Id: 55670524477440
    m_Localized: "\u0417\u0430\u0433\u0443\u0431\u043B\u0435\u043D\u0438\u0439 \u0432\u043E\u0433\u043D\u0438\u043A
      \u0442\u043E\u0433\u043E, \u0445\u0442\u043E \u0437\u0430\u0431\u0443\u0432
      \u0434\u043E\u0440\u043E\u0433\u0443 \u0434\u043E\u0434\u043E\u043C\u0443.
      \u0411\u0435\u0437\u043F\u0435\u0447\u043D\u0438\u0439, \u0446\u0456\u043A\u0430\u0432\u0438\u0439
      \u0456 \u043B\u0435\u0433\u043A\u043E \u043B\u044F\u043A\u0430\u0454\u0442\u044C\u0441\u044F.
      \u041F\u0435\u0440\u0448\u0438\u0439 \u0443\u043B\u043E\u0432 \u043A\u043E\u0436\u043D\u043E\u0433\u043E
      \u0430\u0433\u0435\u043D\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 55670549643264
    m_Localized: "\u0413\u0430\u043B\u0430\u0441\u043B\u0438\u0432\u0438\u0439, \u043D\u0435\u0441\u043F\u043E\u043A\u0456\u0439\u043D\u0438\u0439
      \u0456 \u043D\u0435\u0442\u0435\u0440\u043F\u043B\u044F\u0447\u0438\u0439.
      \u041A\u043E\u043B\u0438 \u0439\u043E\u0433\u043E \u0437\u0430\u0433\u0430\u043D\u044F\u044E\u0442\u044C
      \u0443 \u043A\u0443\u0442 \u2014 \u0437\u043D\u0438\u043A\u0430\u0454 \u0456
      \u0437'\u044F\u0432\u043B\u044F\u0454\u0442\u044C\u0441\u044F \u0437\u0430
      \u043A\u0456\u043B\u044C\u043A\u0430 \u043A\u0440\u043E\u043A\u0456\u0432.
      \u0422\u0440\u0438\u043C\u0430\u0439 \u043F\u0440\u043E\u043C\u0456\u043D\u044C
      \u0440\u0456\u0432\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 55670549643265
    m_Localized: "\u0416\u0438\u0432\u0435 \u043C\u0456\u0436 \u043A\u0430\u0434\u0440\u0430\u043C\u0438.
      \u041B\u0456\u043D\u0437\u0430 \u0431\u0430\u0447\u0438\u0442\u044C \u0439\u043E\u0433\u043E
      \u043B\u0438\u0448\u0435 \u0441\u043F\u0430\u043B\u0430\u0445\u0430\u043C\u0438.
      \u0422\u0435\u0440\u043F\u0456\u043D\u043D\u044F \u2014 \u0454\u0434\u0438\u043D\u0438\u0439
      \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442, \u0449\u043E
      \u043F\u0440\u0430\u0446\u044E\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 123991227760640
    m_Localized: "\u041F\u0420\u0418\u041C\u0410\u0420\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 123991269703680
    m_Localized: "\u0412\u043E\u043D\u0430 \u043D\u0456\u043A\u043E\u043B\u0438 \u043D\u0435
      \u0437\u0443\u043F\u0438\u043D\u044F\u0454\u0442\u044C\u0441\u044F. \u0429\u043E\u0439\u043D\u043E
      \u043F\u0440\u043E\u043C\u0456\u043D\u044C \u0442\u043E\u0440\u043A\u0430\u0454\u0442\u044C\u0441\u044F
      \u0457\u0457, \u0432\u043E\u043D\u0430 \u0440\u0438\u0432\u043A\u043E\u043C
      \u0432\u0438\u043B\u0456\u0442\u0430\u0454 \u0437 \u043A\u0456\u043B\u044C\u0446\u044F.
      \u0426\u0456\u043B\u044C\u0441\u044F \u0442\u0443\u0434\u0438, \u043A\u0443\u0434\u0438
      \u0432\u043E\u043D\u0430 \u043B\u0435\u0442\u0438\u0442\u044C, \u0430 \u043D\u0435
      \u0434\u0435 \u0431\u0443\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 123991273897984
    m_Localized: "\u0411\u0410\u041D\u0428\u0406"
    m_Metadata:
      m_Items: []
  - m_Id: 123991273897985
    m_Localized: "\u0407\u0457 \u043A\u0440\u0438\u043A \u0440\u043E\u0437\u0431\u0438\u0432\u0430\u0454
      \u043B\u0456\u043D\u0437\u0443. \u041F\u0456\u0434\u0456\u0439\u0434\u0438
      \u043D\u0430\u0434\u0442\u043E \u0431\u043B\u0438\u0437\u044C\u043A\u043E,
      \u043A\u043E\u043B\u0438 \u0432\u043E\u043D\u0430 \u0432\u0438\u0434\u0438\u043C\u0430,
      \u0456 \u0432\u043E\u043D\u0430 \u0437\u0430\u043A\u0440\u0438\u0447\u0438\u0442\u044C,
      \u0430 \u0442\u0438 \u0457\u0457 \u0432\u0442\u0440\u0430\u0442\u0438\u0448.
      \u0422\u0440\u0438\u043C\u0430\u0439 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0456\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 123991273897986
    m_Localized: "\u041C\u0406\u041C\u0406\u041A"
    m_Metadata:
      m_Items: []
  - m_Id: 123991273897987
    m_Localized: "\u0412\u0456\u043D \u0431\u0440\u0435\u0448\u0435 \u0442\u0432\u043E\u0457\u043C
      \u043F\u0440\u0438\u043B\u0430\u0434\u0430\u043C. EMF \u0432\u0435\u0434\u0435
      \u0432 \u043E\u0434\u0438\u043D \u0431\u0456\u043A, \u0430 \u0448\u0435\u043F\u0456\u0442
      \u043B\u0443\u043D\u0430\u0454 \u0437 \u0456\u043D\u0448\u043E\u0433\u043E.
      \u0414\u043E\u0432\u0456\u0440\u044F\u0439 \u0432\u0443\u0445\u0430\u043C,
      \u0434\u043E\u043A\u0438 \u043B\u0456\u043D\u0437\u0430 \u0439\u043E\u0433\u043E
      \u043D\u0435 \u0432\u043F\u0456\u0439\u043C\u0430\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 350925186531328
    m_Localized: "\u041D\u0456\u0447\u043D\u0456 \u043C\u0435\u0434\u0441\u0435\u0441\u0442\u0440\u0438
      \u043A\u043B\u044F\u043D\u0443\u0442\u044C\u0441\u044F: \u043E \u0442\u0440\u0435\u0442\u0456\u0439
      \u043D\u043E\u0447\u0456 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u043E\u043C
      \u043F\u043B\u0438\u0432\u0435 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
      \u0432\u043E\u0433\u043D\u0438\u043A \u0456 \u0442\u0456\u043A\u0430\u0454
      \u0432\u0456\u0434 \u043A\u043E\u0436\u043D\u043E\u0433\u043E, \u0445\u0442\u043E
      \u0439\u043E\u0433\u043E \u0433\u0443\u043A\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 350925203308544
    m_Localized: "\u041F\u043E\u0432\u0456\u043B\u044C\u043D\u0438\u0439 \u0456 \u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0438\u0439.
      \u041B\u0456\u043D\u0438\u0432\u043E \u0431\u043B\u0443\u043A\u0430\u0454 \u043A\u0456\u043C\u043D\u0430\u0442\u043E\u044E,
      \u0442\u0456\u043A\u0430\u0454 \u0432\u0456\u0434 \u043F\u0440\u043E\u043C\u0435\u043D\u044F,
      \u0430\u043B\u0435 \u0437\u0430 \u043A\u0456\u043B\u044C\u043A\u0430 \u0441\u0435\u043A\u0443\u043D\u0434
      \u0437\u0430\u0441\u043F\u043E\u043A\u043E\u044E\u0454\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 350925203308545
    m_Localized: "\u0429\u043E\u0439\u043D\u043E \u0432\u0456\u043D \u0442\u0435\u0431\u0435
      \u043F\u043E\u043C\u0456\u0447\u0430\u0454 \u2014 \u0437\u0430\u0432\u043C\u0438\u0440\u0430\u0454:
      \u0441\u0430\u043C\u0435 \u0442\u043E\u0434\u0456 \u0442\u0438\u0441\u043D\u0438
      \u043F\u0440\u043E\u043C\u0456\u043D\u044C. \u041F\u0456\u0434\u0456\u0439\u0434\u0438
      \u0431\u043B\u0438\u0436\u0447\u0435, \u0437\u0431\u043B\u0438\u0437\u044C\u043A\u0430
      \u043F\u0440\u043E\u043C\u0456\u043D\u044C \u0431'\u0454 \u0441\u0438\u043B\u044C\u043D\u0456\u0448\u0435,
      \u0456 \u0432\u0442\u0440\u0438\u043C\u0430\u0439 \u0439\u043E\u0433\u043E
      \u0432 \u043E\u0441\u0442\u0430\u043D\u043D\u044C\u043E\u043C\u0443 \u0440\u0438\u0432\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 350925203308546
    m_Localized: "\u0424\u0430\u0439\u043B \u0430\u0433\u0435\u043D\u0446\u0456\u0457
      0-01: \u043A\u043E\u0436\u0435\u043D \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u0438\u0439
      \u0432\u043E\u0433\u043D\u0438\u043A \u043D\u0435\u0441\u0435 \u0442\u043E\u0439
      \u0441\u0430\u043C\u0438\u0439 \u0441\u043B\u0430\u0431\u043A\u0438\u0439 \u0441\u0438\u0433\u043D\u0430\u043B
      \u2014 \u043A\u043E\u043B\u0438\u0441\u043A\u043E\u0432\u0443 \u043D\u0430
      432 \u0413\u0446. \u0427\u0438\u044E \u2014 \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 350925203308547
    m_Localized: "\u0412\u0456\u043D \u0437\u0430\u0432\u043C\u0438\u0440\u0430\u0454,
      \u043A\u043E\u043B\u0438 \u043F\u043E\u043C\u0456\u0447\u0430\u0454 \u0442\u0435\u0431\u0435:
      \u0431\u0438\u0439 \u043F\u0440\u043E\u043C\u0435\u043D\u0435\u043C \u0441\u0430\u043C\u0435
      \u0442\u043E\u0434\u0456, \u0456 \u0437\u0431\u043B\u0438\u0437\u044C\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 350925203308548
    m_Localized: "\u0422\u0430\u0440\u0456\u043B\u043A\u0438 \u0437\u043B\u0456\u0442\u0430\u044E\u0442\u044C
      \u0437 \u043F\u043E\u043B\u0438\u0446\u044C, \u0434\u0432\u0435\u0440\u0456
      \u0433\u0440\u044E\u043A\u0430\u044E\u0442\u044C \u0443 \u043F\u043E\u0440\u043E\u0436\u043D\u0456\u0445
      \u043A\u0456\u043C\u043D\u0430\u0442\u0430\u0445. \u041C\u0435\u0448\u043A\u0430\u043D\u0446\u0456
      \u043A\u0430\u0436\u0443\u0442\u044C: \u0445\u043E\u043B\u043E\u0434\u043D\u0430
      \u043F\u043B\u044F\u043C\u0430 \u043D\u0456\u043A\u043E\u043B\u0438 \u043D\u0435
      \u0441\u0442\u043E\u0457\u0442\u044C \u043D\u0430 \u043C\u0456\u0441\u0446\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 350925203308549
    m_Localized: "\u041A\u043E\u043B\u0438 \u0437\u0430\u0445\u043E\u043F\u043B\u0435\u043D\u043D\u044F
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u044E\u0454 \u0437\u0430 40%, \u0442\u0435\u043B\u0435\u043F\u043E\u0440\u0442\u0443\u0454\u0442\u044C\u0441\u044F
      \u043D\u0430 2\u20133 \u043C. \u041F\u043E\u0442\u0456\u043C \u0439\u043E\u043C\u0443
      \u0442\u0440\u0435\u0431\u0430 \u0431\u043B\u0438\u0437\u044C\u043A\u043E 5
      \u0441\u0435\u043A\u0443\u043D\u0434, \u0449\u043E\u0431 \u0441\u0442\u0440\u0438\u0431\u043D\u0443\u0442\u0438
      \u0437\u043D\u043E\u0432\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 350925203308550
    m_Localized: "\u041F\u0456\u0441\u043B\u044F \u043A\u043E\u0436\u043D\u043E\u0433\u043E
      \u0441\u0442\u0440\u0438\u0431\u043A\u0430 \u0432\u0456\u043D \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u043D\u043E
      \u0441\u0435\u043A\u0443\u043D\u0434\u0443 \u043E\u0433\u043B\u0443\u0448\u0435\u043D\u0438\u0439.
      \u041F\u0440\u043E\u0432\u0435\u0434\u0438 \u043B\u0456\u043D\u0437\u043E\u044E,
      \u0448\u0432\u0438\u0434\u043A\u043E \u0437\u0430\u0445\u043E\u043F\u0438 \u0439
      \u0431\u0438\u0439, \u043F\u043E\u043A\u0438 \u0432\u0456\u043D \u043D\u0435
      \u043E\u0442\u044F\u043C\u0438\u0432\u0441\u044F: \u0437\u0430\u0445\u043E\u043F\u043B\u0435\u043D\u043D\u044F
      \u0440\u043E\u0441\u0442\u0435 \u0432\u0434\u0432\u0456\u0447\u0456 \u0448\u0432\u0438\u0434\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 350925203308551
    m_Localized: "\u041F\u043E\u043B\u0442\u0435\u0440\u0433\u0435\u0439\u0441\u0442\u0438
      \u2014 \u043D\u0435 \u0434\u0443\u0445\u0438 \u043F\u043E\u043C\u0435\u0440\u043B\u0438\u0445.
      \u0417\u0430 \u0434\u0430\u043D\u0438\u043C\u0438 \u0430\u0433\u0435\u043D\u0446\u0456\u0457,
      \u0432\u043E\u043D\u0438 \u0436\u0438\u0432\u043B\u044F\u0442\u044C\u0441\u044F
      \u0441\u0442\u0440\u0435\u0441\u043E\u043C: \u043A\u043E\u0436\u043D\u043E\u0433\u043E
      \u0437\u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0438 \u0432 \u043E\u0441\u0435\u043B\u0456
      \u043F\u043E\u0441\u0435\u0440\u0435\u0434 \u0441\u0432\u0430\u0440\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 350925203308552
    m_Localized: "\u041F\u0456\u0441\u043B\u044F \u0442\u0435\u043B\u0435\u043F\u043E\u0440\u0442\u0443
      \u0432\u0456\u043D \u0441\u0435\u043A\u0443\u043D\u0434\u0443 \u043E\u0433\u043B\u0443\u0448\u0435\u043D\u0438\u0439:
      \u0437\u0430\u0445\u043E\u043F\u0438 \u043E\u0434\u0440\u0430\u0437\u0443 \u2014
      \u043F\u0440\u043E\u043C\u0456\u043D\u044C \u0437\u0430\u0440\u044F\u0434\u0436\u0430\u0454
      \u0432\u0434\u0432\u0456\u0447\u0456 \u0448\u0432\u0438\u0434\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 350925203308553
    m_Localized: "\u0412\u043E\u0434\u0456\u0457 \u043D\u0430 \u0441\u0442\u0430\u0440\u0456\u0439
      \u043E\u0431\u2019\u0457\u0437\u043D\u0456\u0439 \u0431\u0430\u0447\u0430\u0442\u044C
      \u0431\u043B\u0456\u0434\u0443 \u043F\u043E\u0441\u0442\u0430\u0442\u044C \u043D\u0430
      \u0443\u0437\u0431\u0456\u0447\u0447\u0456 \u2014 \u0456 \u043A\u043B\u044F\u043D\u0443\u0442\u044C\u0441\u044F,
      \u0449\u043E \u0437\u0430 \u043C\u0438\u0442\u044C \u0432\u043E\u043D\u0430
      \u0432\u0436\u0435 \u0431\u0443\u043B\u0430 \u0437 \u0456\u043D\u0448\u043E\u0433\u043E
      \u0431\u043E\u043A\u0443 \u0434\u043E\u0440\u043E\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 350925203308554
    m_Localized: "\u041D\u0430\u0439\u0448\u0432\u0438\u0434\u0448\u0438\u0439 \u0443\u0442\u0456\u043A\u0430\u0447
      \u0432 \u0430\u0440\u0445\u0456\u0432\u0456. \u041F\u0456\u0434 \u043F\u0440\u043E\u043C\u0435\u043D\u0435\u043C
      \u043A\u043E\u0436\u043D\u0456 2 \u0441\u0435\u043A\u0443\u043D\u0434\u0438
      \u0440\u043E\u0431\u0438\u0442\u044C \u0440\u0438\u0432\u043E\u043A \u043D\u0430
      1.5 \u043C \u0443\u0431\u0456\u043A, \u0443\u043F\u043E\u043F\u0435\u0440\u0435\u043A
