      \u043F\u043E\u043A\u0438 \u0432\u0456\u0434\u0432\u0435\u0440\u043D\u0435\u0448\u0441\u044F,
      \u0456 \u043D\u0430\u0431\u043B\u0438\u0436\u0430\u0454\u0442\u044C\u0441\u044F
      \u0431\u0435\u0437\u0437\u0432\u0443\u0447\u043D\u0438\u043C\u0438 \u043A\u0440\u043E\u043A\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 438211513286657
    m_Localized: "\u041D\u0456\u0447\u043D\u0456 \u043E\u0445\u043E\u0440\u043E\u043D\u0446\u0456
      \u043E\u043F\u0438\u0441\u0443\u044E\u0442\u044C \u0442\u0443 \u0441\u0430\u043C\u0443
      \u043F\u043E\u0441\u0442\u0430\u0442\u044C \u0443 \u043A\u0456\u043D\u0446\u0456
      \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0443: \u0449\u043E\u0440\u0430\u0437\u0443,
      \u044F\u043A \u0432\u043E\u043D\u0438 \u0437\u043D\u043E\u0432\u0443 \u0434\u0438\u0432\u043B\u044F\u0442\u044C\u0441\u044F
      \u0432 \u043C\u043E\u043D\u0456\u0442\u043E\u0440, \u0432\u043E\u043D\u0430
      \u0442\u0440\u043E\u0445\u0438 \u0431\u043B\u0438\u0436\u0447\u0435. \u0414\u043E
      \u043E\u0434\u0438\u043D\u0430\u0434\u0446\u044F\u0442\u043E\u0457 \u0457\u0457
      \u043D\u0435 \u0431\u0430\u0447\u0438\u0432 \u043D\u0456\u0445\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 438211513286658
    m_Localized: "\u0420\u0443\u0445\u0430\u0454\u0442\u044C\u0441\u044F, \u043B\u0438\u0448\u0435
      \u043A\u043E\u043B\u0438 \u0442\u0438 \u043D\u0435 \u0434\u0438\u0432\u0438\u0448\u0441\u044F:
      \u0449\u043E\u0439\u043D\u043E \u043A\u0430\u043C\u0435\u0440\u0430 \u043F\u043E\u0432\u0435\u0440\u0442\u0430\u0454\u0442\u044C\u0441\u044F
      \u0434\u043E \u043D\u044C\u043E\u0433\u043E \u2014 \u0437\u0430\u0432\u043C\u0438\u0440\u0430\u0454.
      \u041F\u0456\u0434\u043A\u0440\u0430\u0434\u0430\u0454\u0442\u044C\u0441\u044F
      \u0437\u0430 \u0441\u043F\u0438\u043D\u0443 \u0439 \u043F\u0456\u0434\u0441\u0442\u0443\u043F\u0430\u0454
      \u0431\u043B\u0438\u0436\u0447\u0435; \u0434\u0456\u0439\u0434\u0435 \u0432\u043F\u0440\u0438\u0442\u0443\u043B
      \u2014 \u043A\u0438\u0434\u0430\u0454\u0442\u044C\u0441\u044F. \u0417'\u044F\u0432\u043B\u044F\u0454\u0442\u044C\u0441\u044F
      \u043B\u0438\u0448\u0435 \u0437 23:00 \u0434\u043E 04:00."
    m_Metadata:
      m_Items: []
  - m_Id: 438211513286659
    m_Localized: "\u0421\u043B\u0443\u0445\u0430\u0439 \u043F\u0456\u0434\u043B\u043E\u0433\u0443:
      \u0441\u043A\u0440\u0438\u043F \u043E\u0437\u043D\u0430\u0447\u0430\u0454,
      \u0449\u043E \u0432\u0456\u043D \u0437\u043D\u043E\u0432\u0443 \u0440\u0443\u0448\u0438\u0432.
      \u041E\u0431\u0435\u0440\u043D\u0438\u0441\u044C \u043E\u0434\u0440\u0430\u0437\u0443
      \u2014 \u0441\u043F\u0456\u0439\u043C\u0430\u0454\u0448 \u043D\u0430 \u043F\u0456\u0432\u043A\u0440\u043E\u0446\u0456,
      \u0456 \u0432\u0456\u043D \u043D\u0430 \u043C\u0438\u0442\u044C \u0432\u0440\u0430\u0437\u043B\u0438\u0432\u0438\u0439.
      \u0422\u0440\u0438\u043C\u0430\u0439 \u0439\u043E\u0433\u043E \u0432 \u043A\u0430\u0434\u0440\u0456,
      \u043F\u043E\u043A\u0438 \u0431'\u0454\u0448 \u043F\u0440\u043E\u043C\u0435\u043D\u0435\u043C:
      \u043F\u0456\u0434 \u043F\u043E\u0433\u043B\u044F\u0434\u043E\u043C \u0432\u0456\u043D
      \u043D\u0435 \u0432\u0442\u0435\u0447\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 438211513286660
    m_Localized: "\u041A\u043E\u0436\u043D\u0430 \u0442\u0430\u043A\u0430 \u0441\u043F\u0440\u0430\u0432\u0430
      \u0437\u0430\u043A\u0456\u043D\u0447\u0443\u0454\u0442\u044C\u0441\u044F \u043E\u0434\u043D\u0430\u043A\u043E\u0432\u043E:
      \u043E\u0441\u0442\u0430\u043D\u043D\u0456\u0439 \u0437\u0430\u043F\u0438\u0441
      \u0430\u0433\u0435\u043D\u0442\u0430 \u2014 \u043A\u0430\u0434\u0440 \u0439\u043E\u0433\u043E
      \u0432\u043B\u0430\u0441\u043D\u043E\u0457 \u0441\u043F\u0438\u043D\u0438,
      \u0437\u043D\u044F\u0442\u0438\u0439 \u0442\u0440\u043E\u0445\u0438 \u0432\u0438\u0449\u0435
      \u0433\u043E\u043B\u043E\u0432\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 438211513286661
    m_Localized: "\u0422\u043E\u0439, \u0445\u0442\u043E \u043F\u043E\u0437\u0430\u0434\u0443,
      \u0440\u0443\u0445\u0430\u0454\u0442\u044C\u0441\u044F, \u043B\u0438\u0448\u0435
      \u043A\u043E\u043B\u0438 \u0442\u0438 \u0432\u0456\u0434\u0432\u0435\u0440\u043D\u0443\u0432\u0441\u044F:
      \u0441\u043A\u0440\u0438\u043F\u043D\u0443\u043B\u0430 \u043F\u0456\u0434\u043B\u043E\u0433\u0430
      \u2014 \u043E\u0434\u0440\u0430\u0437\u0443 \u043E\u0431\u0435\u0440\u0442\u0430\u0439\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 438211513286662
    m_Localized: "\u041F\u0440\u0438\u043C\u0430\u0440\u043D\u0438\u0439 \u043A\u0456\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 438211513286663
    m_Localized: "\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u0446\u0456\u043A\u0430\u0432\u0438\u0439
      \u0434\u0443\u0445, \u0449\u043E \u0434\u043E\u0441\u0456 \u0432\u0432\u0430\u0436\u0430\u0454
      \u0446\u044E \u043E\u0441\u0435\u043B\u044E \u0441\u0432\u043E\u0454\u044E.
      \u041D\u0435 \u0442\u0435\u0440\u043F\u0438\u0442\u044C \u0440\u0456\u0437\u043A\u0438\u0445
      \u0440\u0443\u0445\u0456\u0432 \u0456 \u043E\u0431\u043E\u0436\u043D\u044E\u0454
      \u0442\u0438\u0445\u0456 \u043A\u043E\u043B\u0456\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 438211513286664
    m_Localized: "\u041C\u0435\u0448\u043A\u0430\u043D\u0446\u0456 \u0447\u0443\u044E\u0442\u044C
      \u043C\u0443\u0440\u0447\u0430\u043D\u043D\u044F \u0437 \u043F\u043E\u0440\u043E\u0436\u043D\u044C\u043E\u0433\u043E
      \u043A\u0440\u0456\u0441\u043B\u0430, \u0430 \u0432\u0440\u0430\u043D\u0446\u0456
      \u0437\u043D\u0430\u0445\u043E\u0434\u044F\u0442\u044C \u0442\u0435\u043F\u043B\u0443
      \u044F\u043C\u043A\u0443 \u0432 \u043D\u043E\u0433\u0430\u0445 \u043B\u0456\u0436\u043A\u0430.
      \u041A\u043E\u0442\u0430 \u0432 \u0431\u0443\u0434\u0438\u043D\u043A\u0443
      \u043D\u0435 \u0442\u0440\u0438\u043C\u0430\u0454 \u043D\u0456\u0445\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 438211513286665
    m_Localized: "\u0420\u0456\u0437\u043A\u0438\u0439 \u043A\u0440\u043E\u043A \u0447\u0438
      \u0448\u0432\u0438\u0434\u043A\u0438\u0439 \u043F\u043E\u0432\u043E\u0440\u043E\u0442
      \u043A\u0430\u043C\u0435\u0440\u0438 \u2014 \u0456 \u0432\u0456\u043D \u043D\u0430
      \u043A\u0456\u043B\u044C\u043A\u0430 \u0441\u0435\u043A\u0443\u043D\u0434 \u0442\u0456\u043A\u0430\u0454.
      \u041F\u043E\u0441\u0442\u0456\u0439 \u043D\u0435\u0440\u0443\u0445\u043E\u043C\u043E
      \u2014 \u043F\u0456\u0434\u0456\u0439\u0434\u0435 \u0439 \u0441\u044F\u0434\u0435
      \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u043D\u043E \u0437\u0430 1.2 \u043C.
      \u041D\u0456\u043A\u043E\u0433\u043E \u043D\u0435 \u043B\u044F\u043A\u0430\u0454
      \u2014 \u043D\u044F\u0432\u043A\u0430\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 438211513286666
    m_Localized: "\u0417\u0430\u0432\u043C\u0440\u0438 \u0439 \u0434\u0430\u0439
      \u0439\u043E\u043C\u0443 \u043F\u0456\u0434\u0456\u0439\u0442\u0438 \u0441\u0430\u043C\u043E\u043C\u0443.
      \u041F\u043E\u043A\u0438 \u0441\u0438\u0434\u0438\u0442\u044C \u0456 \u043C\u0443\u0440\u0447\u0438\u0442\u044C,
      \u0434\u043E 3 \u0441\u0435\u043A\u0443\u043D\u0434 \u0432\u0456\u043D \u0446\u0456\u043B\u043A\u043E\u043C
      \u0432\u0440\u0430\u0437\u043B\u0438\u0432\u0438\u0439: \u0431\u0438\u0439
      \u043F\u0440\u043E\u043C\u0435\u043D\u0435\u043C, \u043D\u0435 \u0440\u0443\u0445\u0430\u044E\u0447\u0438
      \u0442\u0435\u043B\u0435\u0444\u043E\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 438211513286667
    m_Localized: "\u041F\u0440\u0438\u043C\u0430\u0440\u043D\u0456 \u043A\u043E\u0442\u0438
      \u2014 \u043D\u0435 \u0434\u0443\u0445\u0438 \u0442\u0432\u0430\u0440\u0438\u043D.
      \u0426\u0435 \u0442\u0435, \u0449\u043E \u043E\u0441\u0435\u043B\u044F \u043F\u0430\u043C\u2019\u044F\u0442\u0430\u0454
      \u043F\u0440\u043E \u0432\u0435\u0447\u043E\u0440\u0438, \u043A\u043E\u043B\u0438
      \u0432 \u043D\u0456\u0439 \u0431\u0443\u043B\u043E \u0449\u0430\u0441\u043B\u0438\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 438211513286668
    m_Localized: "\u041A\u0456\u0442 \u0442\u0456\u043A\u0430\u0454 \u0432\u0456\u0434
      \u0440\u0456\u0437\u043A\u0438\u0445 \u0440\u0443\u0445\u0456\u0432: \u0441\u0442\u0456\u0439
      \u0442\u0438\u0445\u043E \u2014 \u0432\u0456\u043D \u0441\u0430\u043C \u043F\u0456\u0434\u0456\u0439\u0434\u0435
      \u0439 \u0441\u044F\u0434\u0435 \u043F\u043E\u0440\u0443\u0447."
    m_Metadata:
      m_Items: []
  - m_Id: 496208654499840
    m_Localized: "\u0414\u043E\u043C\u043E\u0432\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 496208692248576
    m_Localized: "\u0414\u0443\u0445 \u0441\u0430\u043C\u043E\u0457 \u043E\u0441\u0435\u043B\u0456:
      \u0431\u0443\u0440\u0447\u043B\u0438\u0432\u0438\u0439 \u0434\u0456\u0434\u043E\u043A,
      \u0449\u043E \u0436\u0438\u0432\u0435 \u0437\u0430 \u043F\u0456\u0447\u0447\u044E
      \u0439 \u0442\u0435\u0440\u043F\u0456\u0442\u0438 \u043D\u0435 \u043C\u043E\u0436\u0435,
      \u043A\u043E\u043B\u0438 \u0439\u043E\u0433\u043E \u0442\u0443\u0440\u0431\u0443\u044E\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 496208692248577
    m_Localized: "\u0411\u0430\u0431\u0443\u0441\u0456 \u0439 \u0434\u043E\u0441\u0456
      \u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C \u0439\u043E\u043C\u0443 \u0431\u043B\u044E\u0434\u0435\u0447\u043A\u043E
      \u043C\u043E\u043B\u043E\u043A\u0430. \u0422\u0430\u043C, \u0434\u0435 \u043D\u0435
      \u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C, \u0433\u0443\u0431\u043B\u044F\u0442\u044C\u0441\u044F
      \u043A\u043B\u044E\u0447\u0456, \u0432\u043D\u043E\u0447\u0456 \u0441\u0442\u0443\u043A\u0430\u044E\u0442\u044C
      \u0434\u0432\u0435\u0440\u0456, \u0430 \u0447\u0430\u0448\u043A\u0438 \u0434\u0437\u0435\u043B\u0435\u043D\u0447\u0430\u0442\u044C
      \u0441\u0430\u043C\u0456 \u0441\u043E\u0431\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 496208692248578
    m_Localized: "\u0429\u043E\u0439\u043D\u043E \u043F\u043E\u043C\u0456\u0442\u0438\u0442\u044C
      \u0442\u0435\u0431\u0435 \u2014 \u0445\u043E\u0432\u0430\u0454\u0442\u044C\u0441\u044F
      \u043C\u0430\u0439\u0436\u0435 \u0432\u0435\u0441\u044C \u0447\u0430\u0441,
      \u043F\u0435\u0440\u0435\u0431\u0456\u0433\u0430\u0454 \u043C\u0456\u0436 \u0441\u0445\u043E\u0432\u0430\u043D\u043A\u0430\u043C\u0438
      \u0439 \u0449\u043E\u043A\u0456\u043B\u044C\u043A\u0430 \u0441\u0435\u043A\u0443\u043D\u0434
      \u0441\u0442\u0443\u043A\u0430\u0454 \u0437\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0438
      \u043C\u0435\u0431\u043B\u0456\u0432. \u041D\u0430 \u043A\u0430\u043C\u0435\u0440\u0443
      \u043D\u0435 \u043A\u0438\u0434\u0430\u0454\u0442\u044C\u0441\u044F: \u0437\u0430\u0436\u0435\u043D\u0435\u0448
      \u0443 \u043A\u0443\u0442 \u2014 \u0437\u0430\u0433\u0440\u0438\u043C\u0438\u0442\u044C
      \u043F\u043E\u0441\u0443\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 496208692248579
    m_Localized: "\u0406\u0434\u0438 \u043D\u0430 \u0441\u0442\u0443\u043A \u0456
      \u0445\u043E\u043B\u043E\u0434\u043D\u0443 \u043F\u043B\u044F\u043C\u0443,
      \u043F\u0456\u0434\u0456\u0439\u0434\u0438 \u0432\u043F\u0440\u0438\u0442\u0443\u043B
      \u0434\u043E \u0441\u0445\u043E\u0432\u0430\u043D\u043A\u0438 \u0439 \u0437\u043D\u0430\u0439\u0434\u0438
      \u0439\u043E\u0433\u043E \u043B\u0456\u043D\u0437\u043E\u044E: \u0432\u0438\u043C\u0430\u043D\u0435\u043D\u0438\u0439,
      \u0432\u0456\u043D 2 \u0441\u0435\u043A\u0443\u043D\u0434\u0438 \u043E\u0433\u043B\u0443\u0448\u0435\u043D\u0438\u0439.
      \u0422\u043E\u0434\u0456 \u0439 \u0431\u0438\u0439 \u043F\u0440\u043E\u043C\u0435\u043D\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 496208692248580
    m_Localized: "\u0410\u0433\u0435\u043D\u0442\u0438, \u0449\u043E \u043B\u043E\u0432\u0438\u043B\u0438
      \u0434\u043E\u043C\u043E\u0432\u0438\u043A\u0430, \u043A\u0430\u0436\u0443\u0442\u044C
      \u043E\u0434\u043D\u0435: \u0442\u0438\u0436\u0434\u0435\u043D\u044C \u043F\u043E\u0442\u043E\u043C\u0443
      \u0432 \u0457\u0445\u043D\u0456\u0439 \u0432\u043B\u0430\u0441\u043D\u0456\u0439
      \u043E\u0441\u0435\u043B\u0456 \u0431\u0443\u043B\u043E \u0445\u043E\u043B\u043E\u0434\u043D\u0456\u0448\u0435.
      \u0422\u0435\u043F\u0435\u0440 \u0430\u0433\u0435\u043D\u0442\u0441\u0442\u0432\u043E
      \u0432\u0456\u0434\u043F\u0443\u0441\u043A\u0430\u0454 \u0457\u0445 \u043D\u0430\u0437\u0430\u0434,
      \u0443 \u0442\u0443 \u0441\u0430\u043C\u0443 \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 496208692248581
    m_Localized: "\u0414\u043E\u043C\u043E\u0432\u0438\u043A \u0445\u043E\u0432\u0430\u0454\u0442\u044C\u0441\u044F
      \u0439 \u0441\u0442\u0443\u043A\u0430\u0454: \u0456\u0434\u0438 \u043D\u0430
      \u0437\u0432\u0443\u043A, \u043F\u0456\u0434\u0456\u0439\u0434\u0438 \u0432\u043F\u0440\u0438\u0442\u0443\u043B
      \u0456 \u0432\u0438\u043C\u0430\u043D\u0438 \u0439\u043E\u0433\u043E \u043B\u0456\u043D\u0437\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 496208692248582
    m_Localized: "\u041D\u0435\u0433\u0430\u0442\u0438\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 496208692248583
    m_Localized: "\u041F\u043E\u0441\u0442\u0430\u0442\u044C, \u0449\u043E \u0456\u0441\u043D\u0443\u0454
      \u043B\u0438\u0448\u0435 \u043D\u0430 \u043F\u043B\u0456\u0432\u0446\u0456.
      \u041B\u0456\u043D\u0437\u0430 \u043D\u0435 \u043F\u043E\u043A\u0430\u0437\u0443\u0454
      \u043D\u0456\u0447\u043E\u0433\u043E \u2014 \u043A\u0430\u043C\u0435\u0440\u0430
      \u043F\u043E\u043A\u0430\u0437\u0443\u0454 \u0432\u0441\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 496208692248584
    m_Localized: "\u0421\u0442\u0430\u0440\u0456 \u0444\u043E\u0442\u043E\u0430\u0442\u0435\u043B\u044C\u0454
      \u0432\u0438\u043A\u0438\u0434\u0430\u043B\u0438 \u0446\u0456\u043B\u0456 \u043F\u043B\u0456\u0432\u043A\u0438
      \u0447\u0435\u0440\u0435\u0437 \u0442\u0443 \u0441\u0430\u043C\u0443 \u043F\u043E\u0441\u0442\u0430\u0442\u044C
      \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u044E \u043A\u043E\u0436\u043D\u043E\u0457
      \u0440\u043E\u0434\u0438\u043D\u0438 \u2014 \u0449\u043E\u043A\u0430\u0434\u0440\u0443
      \u0431\u043B\u0438\u0436\u0447\u0435. \u041A\u043E\u043B\u0438 \u0437\u043D\u0456\u043C\u0430\u043B\u0438,
      \u0457\u0457 \u0442\u0430\u043C \u043D\u0435 \u0431\u0443\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 496208692248585
    m_Localized: "\u041B\u0456\u043D\u0437\u0430 \u0439\u043E\u0433\u043E \u043D\u0435
      \u0431\u0430\u0447\u0438\u0442\u044C, \u0430 EMF \u0456 \u0448\u0435\u043F\u0456\u0442
      \u2014 \u0447\u0443\u044E\u0442\u044C. \u0424\u043E\u0442\u043E, \u0443 \u043A\u0430\u0434\u0440\u0456
      \u044F\u043A\u043E\u0433\u043E \u0432\u0456\u043D \u043E\u043F\u0438\u043D\u0438\u0432\u0441\u044F,
      \u043F\u0440\u043E\u044F\u0432\u043B\u044F\u0454 \u0439\u043E\u0433\u043E \u043D\u0430
      5 \u0441\u0435\u043A\u0443\u043D\u0434: \u043B\u0438\u0448\u0435 \u0442\u043E\u0434\u0456
      \u043B\u0456\u043D\u0437\u0430 \u0439 \u043F\u0440\u043E\u043C\u0456\u043D\u044C
      \u043C\u043E\u0436\u0443\u0442\u044C \u0439\u043E\u0433\u043E \u0432\u0437\u044F\u0442\u0438.
      \u0417\u0430\u0442\u0432\u043E\u0440 \u0437\u0432\u043E\u0434\u0438\u0442\u044C\u0441\u044F,
      \u043A\u043E\u043B\u0438 \u0432\u0456\u043D \u0431\u043B\u0438\u0437\u044C\u043A\u043E
      \u0439 \u0443 \u043A\u0430\u0434\u0440\u0456, \u043D\u0430\u0432\u0456\u0442\u044C
      \u043D\u0435\u0432\u0438\u0434\u0438\u043C\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 496208692248586
    m_Localized: "\u0422\u0443\u0442 \u0443\u0441\u0435 \u0432\u0438\u0440\u0456\u0448\u0443\u0454
      \u043F\u043B\u0456\u0432\u043A\u0430. \u041F\u0456\u0434\u0445\u043E\u0434\u044C
      \u0437\u0430 EMF \u0456 \u0448\u0435\u043F\u043E\u0442\u043E\u043C, \u0437\u043D\u0456\u043C\u0430\u0439,
      \u0449\u043E\u0439\u043D\u043E \u0437\u0430\u0442\u0432\u043E\u0440 \u0437\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F,
      \u0456 \u043E\u0434\u0440\u0430\u0437\u0443 \u0431\u0438\u0439 \u043F\u0440\u043E\u043C\u0435\u043D\u0435\u043C,
      \u043F\u043E\u043A\u0438 \u0432\u0456\u043D \u043F\u0440\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u0439.
      \u041A\u043E\u0436\u043D\u0435 \u043D\u043E\u0432\u0435 \u0444\u043E\u0442\u043E
      \u0434\u0430\u0454 \u0449\u0435 5 \u0441\u0435\u043A\u0443\u043D\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 496208692248587
    m_Localized: "\u0410\u0433\u0435\u043D\u0442\u0441\u0442\u0432\u043E \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0454
      \u043A\u043E\u0436\u043D\u0443 \u043F\u043B\u0456\u0432\u043A\u0443, \u043D\u0430
      \u044F\u043A\u0456\u0439 \u0437'\u044F\u0432\u043B\u044F\u0432\u0441\u044F
      \u043D\u0435\u0433\u0430\u0442\u0438\u0432. \u041F\u0440\u043E\u044F\u0432\u043B\u0435\u043D\u0456
      \u0432\u0434\u0440\u0443\u0433\u0435, \u0436\u043E\u0434\u043D\u0430 \u0437
      \u043D\u0438\u0445 \u043D\u0435 \u043F\u043E\u043A\u0430\u0437\u0443\u0454
      \u0442\u043E\u0433\u043E \u0441\u0430\u043C\u043E\u0433\u043E \u043A\u0430\u0434\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 496208692248588
    m_Localized: "\u041B\u0456\u043D\u0437\u0430 \u043D\u0435 \u0431\u0430\u0447\u0438\u0442\u044C
      \u041D\u0435\u0433\u0430\u0442\u0438\u0432\u0430: \u0441\u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0443\u0439
      \u0439\u043E\u0433\u043E \u0439 \u0431\u0438\u0439 \u043F\u0440\u043E\u043C\u0435\u043D\u0435\u043C,
      \u043F\u043E\u043A\u0438 \u0432\u0456\u043D \u043F\u0440\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 496208692248589
    m_Localized: "\u041A\u0430\u0439\u0434\u0430\u043D\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 496208692248590
    m_Localized: "\u0412\u0438\u0441\u043E\u043A\u0438\u0439 \u0432'\u044F\u0437\u0435\u043D\u044C
      \u0443 \u043A\u0430\u043F\u0442\u0443\u0440\u0456, \u0449\u043E \u0434\u043E\u0441\u0456
      \u0442\u044F\u0433\u043D\u0435 \u043A\u0430\u0439\u0434\u0430\u043D\u0438,
      \u0432 \u044F\u043A\u0438\u0445 \u043F\u043E\u043C\u0435\u0440. \u041F\u043E\u0432\u0456\u043B\u044C\u043D\u0438\u0439,
      \u0432\u0430\u0436\u043A\u0438\u0439 \u0456 \u0434\u0443\u0436\u0435 \u0432\u043F\u0435\u0440\u0442\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 496208692248591
    m_Localized: "\u041D\u0456\u0447\u043D\u0456 \u0441\u0442\u043E\u0440\u043E\u0436\u0456
      \u0441\u0442\u0430\u0440\u043E\u0457 \u0432'\u044F\u0437\u043D\u0438\u0446\u0456
      \u0447\u0443\u044E\u0442\u044C, \u044F\u043A \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u043E\u043C,
      \u0434\u0435 \u043A\u043E\u043B\u0438\u0441\u044C \u0431\u0443\u043B\u0438
      \u043A\u0430\u043C\u0435\u0440\u0438, \u0442\u044F\u0433\u043D\u0443\u0442\u044C
      \u043B\u0430\u043D\u0446\u044E\u0433\u0438. \u0422\u043E\u0439 \u043A\u043E\u0440\u0438\u0434\u043E\u0440
      \u0443\u0436\u0435 \u0441\u043E\u0440\u043E\u043A \u0440\u043E\u043A\u0456\u0432
      \u044F\u043A \u0441\u0442\u043E\u044F\u043D\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 496208692248592
    m_Localized: "\u041F\u043E\u0432\u0456\u043B\u044C\u043D\u0438\u0439, \u0430\u043B\u0435
      \u043D\u0430\u0439\u0432\u0430\u0436\u0447\u0438\u0439 \u0434\u043B\u044F \u0443\u0442\u0440\u0438\u043C\u0430\u043D\u043D\u044F:
      \u043F\u0456\u0434 \u043F\u0440\u043E\u043C\u0435\u043D\u0435\u043C \u0434\u0432\u0456\u0447\u0456
      \u0441\u043C\u0438\u043A\u0430\u0454 \u043B\u0430\u043D\u0446\u044E\u0433\u043E\u043C
      \u0443\u0431\u0456\u043A \u2014 \u043D\u0430 40% \u0456 70% \u0437\u0430\u0445\u043E\u043F\u043B\u0435\u043D\u043D\u044F.
      \u042F\u043A\u0449\u043E \u043F\u0456\u0441\u043B\u044F \u0440\u0438\u0432\u043A\u0430
      \u043A\u0456\u043B\u044C\u0446\u0435 \u0439\u043E\u0433\u043E \u0437\u0430\u0433\u0443\u0431\u0438\u043B\u043E
      \u2014 \u043C\u0456\u043D\u0443\u0441 25%. \u0419\u043E\u0433\u043E \u043B\u0430\u043D\u0446\u044E\u0433\u0438
      \u0447\u0443\u0442\u0438 \u0437 \u0456\u043D\u0448\u043E\u0433\u043E \u043A\u0456\u043D\u0446\u044F
      \u043A\u0456\u043C\u043D\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 496208692248593
    m_Localized: "\u0422\u0440\u0438\u043C\u0430\u0439 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0456\u044E,
      \u0449\u043E\u0431 \u0440\u0438\u0432\u043E\u043A \u043D\u0435 \u0432\u0438\u043A\u0438\u043D\u0443\u0432
      \u0439\u043E\u0433\u043E \u0437 \u043A\u0456\u043B\u044C\u0446\u044F, \u0456
      \u0432\u0435\u0434\u0438 \u0439\u043E\u0433\u043E \u0432\u0431\u0456\u043A,
      \u0449\u043E\u0439\u043D\u043E \u0431\u0440\u044F\u0437\u043D\u0443\u0442\u044C
      \u043B\u0430\u043D\u0446\u044E\u0433\u0438. \u041B\u0430\u0437\u0435\u0440
      \u0456\u0437 \u0448\u0438\u0440\u0448\u0438\u043C \u043A\u0456\u043B\u044C\u0446\u0435\u043C
      \u0434\u0443\u0436\u0435 \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 496208692248594
    m_Localized: "\u041D\u0456\u0445\u0442\u043E \u043D\u0435 \u0437\u043D\u0430\u0454,
      \u0437\u0430 \u0449\u043E \u0439\u043E\u0433\u043E \u0437\u0430\u0441\u0443\u0434\u0438\u043B\u0438.
      \u041A\u043E\u0436\u0435\u043D \u0430\u0433\u0435\u043D\u0442, \u0449\u043E
      \u043F\u0438\u0442\u0430\u0432, \u0447\u0443\u0432 \u043A\u0440\u0456\u0437\u044C
      \u0431\u0440\u044F\u0437\u043A\u0456\u0442 \u043E\u0434\u043D\u0443 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u044C:
      \xAB\u043D\u0456 \u0437\u0430 \u0449\u043E\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 496208692248595
    m_Localized: "\u041A\u0430\u0439\u0434\u0430\u043D\u043D\u0438\u043A \u0441\u043C\u0438\u043A\u0430\u0454
      \u043B\u0430\u043D\u0446\u044E\u0433\u043E\u043C \u043D\u0430 40% \u0456 70%:
      \u0442\u0440\u0438\u043C\u0430\u0439 \u0439\u043E\u0433\u043E \u0432 \u043A\u0456\u043B\u044C\u0446\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 496208692248596
    m_Localized: "\u041C\u0430\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 496208692248597
    m_Localized: "\u041A\u043E\u0448\u043C\u0430\u0440 \u043F\u0456\u0434 \u0432\u0443\u0430\u043B\u043B\u044E,
      \u0449\u043E \u0439\u0434\u0435 \u043D\u0430 \u0441\u0432\u0456\u0442\u043B\u043E.
      \u0423\u0432\u0456\u043C\u043A\u043D\u0438 \u043B\u0456\u043D\u0437\u0443 \u2014
      \u0456 \u0432\u043E\u043D\u0430 \u043F\u0456\u0434\u0435 \u0434\u043E \u0442\u0435\u0431\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 496208692248598
    m_Localized: "\u0421\u0456\u0434\u0430\u0454 \u043D\u0430 \u0433\u0440\u0443\u0434\u0438
      \u0442\u0438\u043C, \u0445\u0442\u043E \u0441\u043F\u0438\u0442\u044C \u043F\u0440\u0438
      \u0441\u0432\u0456\u0442\u043B\u0456. \u041F\u0440\u043E\u043A\u0438\u0434\u0430\u044E\u0442\u044C\u0441\u044F
      \u0432\u043E\u043D\u0438 \u0437 \u0440\u043E\u0437\u0440\u044F\u0434\u0436\u0435\u043D\u0438\u043C
      \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u043E\u043C, \u043C\u0435\u0440\u0442\u0432\u0438\u043C
      \u043B\u0456\u0445\u0442\u0430\u0440\u0438\u043A\u043E\u043C \u0456 \u0431\u0435\u0437
      \u0436\u043E\u0434\u043D\u043E\u0433\u043E \u0441\u043F\u043E\u0433\u0430\u0434\u0443
      \u043F\u0440\u043E \u043D\u0456\u0447."
    m_Metadata:
      m_Items: []
  - m_Id: 496208692248599
    m_Localized: "\u041F\u043E\u043A\u0438 \u043B\u0456\u043D\u0437\u0430 \u043D\u0430
      \u043D\u0456\u0439 \u2014 \u0432\u043E\u043D\u0430 \u0439\u0434\u0435 \u0434\u043E
      \u0442\u0435\u0431\u0435; \u0443 \u0442\u0435\u043C\u0440\u044F\u0432\u0456
      \u0432\u0456\u0434\u0441\u0442\u0443\u043F\u0430\u0454 \u0439 \u0445\u043E\u0432\u0430\u0454\u0442\u044C\u0441\u044F.
      \u041E\u043F\u0438\u043D\u0438\u0448\u0441\u044F \u0431\u043B\u0438\u0436\u0447\u0435
      1.3 \u043C \u0437 \u0443\u0432\u0456\u043C\u043A\u043D\u0435\u043D\u043E\u044E
      \u043B\u0456\u043D\u0437\u043E\u044E \u2014 \u043A\u0438\u0434\u0430\u0454\u0442\u044C\u0441\u044F,
      \u0432\u0456\u0434\u043A\u0443\u0448\u0443\u0454 20% \u0431\u0430\u0442\u0430\u0440\u0435\u0457,
      \u0432\u0456\u0434\u0441\u043A\u0430\u043A\u0443\u0454 \u0439 1.2 \u0441\u0435\u043A\u0443\u043D\u0434\u0438
      \u0432\u0438\u0441\u043D\u0430\u0436\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 496208692248600
    m_Localized: "\u0412\u043C\u0438\u043A\u0430\u0439 \u043B\u0456\u043D\u0437\u0443
      \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u043C\u0438 \u0441\u043F\u0430\u043B\u0430\u0445\u0430\u043C\u0438
      \u0437 \u0432\u0456\u0434\u0441\u0442\u0430\u043D\u0456 \u2014 \u043B\u0438\u0448\u0435
      \u043A\u043E\u043B\u0438 \u0432\u043E\u043D\u0430 \u0432\u0436\u0435 \u0432
      \u043A\u0456\u043B\u044C\u0446\u0456 \u2014 \u0456 \u043E\u0434\u0440\u0430\u0437\u0443
      \u0431\u0438\u0439 \u043F\u0440\u043E\u043C\u0435\u043D\u0435\u043C. \u041A\u0438\u043D\u0443\u043B\u0430\u0441\u044C
      \u2014 \u043A\u0430\u0440\u0430\u0439, \u043F\u043E\u043A\u0438 \u0432\u043E\u043D\u0430
      \u0432\u0438\u0441\u043D\u0430\u0436\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 496208692248601
    m_Localized: "\u0423 \u043A\u043E\u0436\u043D\u0456\u0439 \u0441\u043F\u0440\u0430\u0432\u0456
      \u043C\u0430\u0440\u0438 \u0454 \u0444\u043E\u0442\u043E \u043F\u043E\u0440\u043E\u0436\u043D\u044C\u043E\u0457
      \u0441\u043F\u0430\u043B\u044C\u043D\u0456 \u0437 \u0443\u0432\u0456\u043C\u043A\u043D\u0435\u043D\u043E\u044E
      \u043B\u0430\u043C\u043F\u043E\u044E. \u0425\u0442\u043E \u0457\u0445 \u0437\u043D\u0456\u043C\u0430\u0454,
      \u0430\u0433\u0435\u043D\u0442\u0441\u0442\u0432\u043E \u0442\u0430\u043A \u0456
