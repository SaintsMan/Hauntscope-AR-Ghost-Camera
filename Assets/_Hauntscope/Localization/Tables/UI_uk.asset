  - m_Id: 70994242174976
    m_Localized: "\u041F\u0420\u041E\u0414\u041E\u0412\u0416\u0418\u0422\u0418"
    m_Metadata:
      m_Items: []
  - m_Id: 70994242174977
    m_Localized: "\u041D\u0410\u041B\u0410\u0428\u0422\u0423\u0412\u0410\u041D\u041D\u042F"
    m_Metadata:
      m_Items: []
  - m_Id: 70994242174978
    m_Localized: "\u0412\u0418\u0419\u0422\u0418 \u0412 \u041C\u0415\u041D\u042E"
    m_Metadata:
      m_Items: []
  - m_Id: 70994242174979
    m_Localized: "\u0422\u0420\u0415\u041A\u0406\u041D\u0413 \u0412\u0422\u0420\u0410\u0427\u0415\u041D\u041E"
    m_Metadata:
      m_Items: []
  - m_Id: 70994242174980
    m_Localized: "\u0420\u0443\u0445\u0430\u0439\u0441\u044F \u043F\u043E\u0432\u0456\u043B\u044C\u043D\u043E
      \u0439 \u0434\u043E\u0434\u0430\u0439 \u0441\u0432\u0456\u0442\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 70994242174981
    m_Localized: "\u041E\u043A\u043B\u044E\u0437\u0456\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 94804563591168
    m_Localized: "\u0414\u041E\u0421\u0422\u0423\u041F \u0414\u041E \u041A\u0410\u041C\u0415\u0420\u0418"
    m_Metadata:
      m_Items: []
  - m_Id: 94804605534208
    m_Localized: "Hauntscope \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0430 \u043A\u0430\u043C\u0435\u0440\u0430,
      \u0449\u043E\u0431 \u043F\u043E\u043A\u0430\u0437\u0443\u0432\u0430\u0442\u0438
      \u043F\u0440\u0438\u0432\u0438\u0434\u0456\u0432 \u0443 \u0442\u0432\u043E\u0457\u0439
      \u043A\u0456\u043C\u043D\u0430\u0442\u0456. \u0411\u0435\u0437 \u043D\u0435\u0457
      \u043F\u043E\u043B\u044E\u0432\u0430\u043D\u043D\u044F \u0431\u0443\u0434\u0435
      \u0443 \u0412\u0456\u0440\u0442\u0443\u0430\u043B\u044C\u043D\u0456\u0439 \u043A\u0456\u043C\u043D\u0430\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 94804605534209
    m_Localized: "\u0414\u043E\u0441\u0442\u0443\u043F \u0434\u043E \u043A\u0430\u043C\u0435\u0440\u0438
      \u0432\u0438\u043C\u043A\u043D\u0435\u043D\u043E. \u0412\u0456\u0434\u043A\u0440\u0438\u0439
      \u043D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u043D\u044F \u0437\u0430\u0441\u0442\u043E\u0441\u0443\u043D\u043A\u0443
      \u0439 \u0434\u043E\u0437\u0432\u043E\u043B\u044C \u041A\u0430\u043C\u0435\u0440\u0443
      \u0432 \u0440\u043E\u0437\u0434\u0456\u043B\u0456 \u0414\u043E\u0437\u0432\u043E\u043B\u0438.
      \u0411\u0435\u0437 \u043D\u0435\u0457 \u043F\u043E\u043B\u044E\u0432\u0430\u043D\u043D\u044F
      \u0431\u0443\u0434\u0435 \u0443 \u0412\u0456\u0440\u0442\u0443\u0430\u043B\u044C\u043D\u0456\u0439
      \u043A\u0456\u043C\u043D\u0430\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 94804605534210
    m_Localized: "\u0414\u041E\u0417\u0412\u041E\u041B\u0418\u0422\u0418 \u041A\u0410\u041C\u0415\u0420\u0423"
    m_Metadata:
      m_Items: []
  - m_Id: 94804605534211
    m_Localized: "\u0412\u0406\u0414\u041A\u0420\u0418\u0422\u0418 \u041D\u0410\u041B\u0410\u0428\u0422\u0423\u0412\u0410\u041D\u041D\u042F"
    m_Metadata:
      m_Items: []
  - m_Id: 94804605534212
    m_Localized: "\u0413\u0420\u0410\u0422\u0418 \u0423 \u0412\u0406\u0420\u0422\u0423\u0410\u041B\u042C\u041D\u0406\u0419
      \u041A\u0406\u041C\u041D\u0410\u0422\u0406"
    m_Metadata:
      m_Items: []
  - m_Id: 94804605534213
    m_Localized: "AR \u041D\u0415\u0414\u041E\u0421\u0422\u0423\u041F\u041D\u0418\u0419"
    m_Metadata:
      m_Items: []
  - m_Id: 94804605534214
    m_Localized: "\u0422\u0432\u0456\u0439 \u043F\u0440\u0438\u0441\u0442\u0440\u0456\u0439
      \u043D\u0435 \u043F\u0456\u0434\u0442\u0440\u0438\u043C\u0443\u0454 AR. \u041F\u043E\u043B\u044E\u0432\u0430\u043D\u043D\u044F
      \u0431\u0443\u0434\u0435 \u0443 \u0412\u0456\u0440\u0442\u0443\u0430\u043B\u044C\u043D\u0456\u0439
      \u043A\u0456\u043C\u043D\u0430\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 94804605534215
    m_Localized: "\u0413\u0410\u0420\u0410\u0417\u0414"
    m_Metadata:
      m_Items: []
  - m_Id: 111728735420416
    m_Localized: "Hauntscope \u2014 \u0433\u0440\u0430 \u043B\u0438\u0448\u0435 \u0434\u043B\u044F
      \u0440\u043E\u0437\u0432\u0430\u0433\u0438. \u0412\u043E\u043D\u0430 \u043D\u0435
      \u0432\u0438\u044F\u0432\u043B\u044F\u0454 \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u044C\u043E\u0457
      \u043F\u0430\u0440\u0430\u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E\u0457
      \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 111728768974848
    m_Localized: Hauntscope
    m_Metadata:
      m_Items: []
  - m_Id: 123992666406912
    m_Localized: "\u041D\u0410\u0412\u0427\u0410\u041D\u041D\u042F {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 123992691572736
    m_Localized: "\u0422\u044F\u0433\u043D\u0438 \u043F\u043E \u043B\u0456\u0432\u0456\u0439
      \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0456, \u0449\u043E\u0431 \u0456\u0442\u0438.
      \u0421\u0432\u0430\u0439\u043F \u043F\u043E \u043F\u0440\u0430\u0432\u0456\u0439,
      \u0449\u043E\u0431 \u0440\u043E\u0437\u0437\u0438\u0440\u043D\u0443\u0442\u0438\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 123992691572737
    m_Localized: "\u041F\u0440\u0438\u0432\u0438\u0434 \u0442\u0443\u0442, \u0430\u043B\u0435
      \u043D\u0435\u0432\u0438\u0434\u0438\u043C\u0438\u0439. \u0406\u0434\u0438
      \u0437\u0430 EMF: \u0449\u043E \u0431\u043B\u0438\u0436\u0447\u0435 \u043F\u0440\u0438\u0432\u0438\u0434,
      \u0442\u043E \u0447\u0430\u0441\u0442\u0456\u0448\u0435 \u043F\u0438\u0449\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 123992691572738
    m_Localized: "\u0423\u0432\u0456\u043C\u043A\u043D\u0438 \u041B\u0406\u041D\u0417\u0423
      \u0439 \u043F\u043E\u0432\u0456\u043B\u044C\u043D\u043E \u043F\u043E\u0432\u0435\u0440\u0442\u0430\u0439\u0441\u044F.
      \u0412\u043E\u043D\u0430 \u043F\u0440\u043E\u044F\u0432\u0438\u0442\u044C \u043F\u0440\u0438\u0432\u0438\u0434\u0430,
      \u0430\u043B\u0435 \u0440\u043E\u0437\u0440\u044F\u0434\u0436\u0430\u0454 \u0431\u0430\u0442\u0430\u0440\u0435\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 123992691572739
    m_Localized: "\u0422\u0440\u0438\u043C\u0430\u0439 \u041F\u0420\u041E\u041C\u0406\u041D\u042C
      \u0456 \u043D\u0435 \u0432\u0438\u043F\u0443\u0441\u043A\u0430\u0439 \u043F\u0440\u0438\u0432\u0438\u0434\u0430
      \u0437 \u043A\u0456\u043B\u044C\u0446\u044F, \u0434\u043E\u043A\u0438 \u043D\u0435
      \u0441\u043F\u0456\u0439\u043C\u0430\u0454\u0448. \u041D\u0435 \u0434\u0430\u0439
      \u0431\u0430\u0442\u0430\u0440\u0435\u0457 \u0441\u0456\u0441\u0442\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 149880640503808
    m_Localized: "\u0413\u041E\u0422\u041E\u0412\u041D\u0406\u0421\u0422\u042C"
    m_Metadata:
      m_Items: []
  - m_Id: 149880674058240
