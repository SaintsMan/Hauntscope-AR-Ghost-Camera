  m_Name: Store_pt-BR
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pt-BR
  m_SharedData: {fileID: 11400000, guid: 2866b66d97950fe4a88f0cb2dddde093, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1129709568
    m_Localized: "M1 PADR\xC3O"
    m_Metadata:
      m_Items: []
  - m_Id: 1146486784
    m_Localized: "Equipamento padr\xE3o da ag\xEAncia. Confi\xE1vel, e s\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 1146486785
    m_Localized: W2 HOLOFOTE
    m_Metadata:
      m_Items: []
  - m_Id: 1146486786
    m_Localized: "Um anel largo que perdoa a m\xE3o tr\xEAmula. A captura se desfaz
      na metade da velocidade."
    m_Metadata:
      m_Items: []
  - m_Id: 1146486787
    m_Localized: T3 AMARRA
    m_Metadata:
      m_Items: []
  - m_Id: 1146486788
    m_Localized: 'Prende o fantasma: metade da velocidade no raio, captura +20%.'
    m_Metadata:
      m_Items: []
  - m_Id: 1146486789
    m_Localized: "P4 LAN\xC7A DE FASE"
    m_Metadata:
      m_Items: []
  - m_Id: 1146486790
    m_Localized: "Captura 60% mais r\xE1pido e segura fantasmas que somem. Anel estreito."
    m_Metadata:
      m_Items: []
  - m_Id: 1146486791
    m_Localized: BATERIA RESERVA
    m_Metadata:
      m_Items: []
  - m_Id: 1146486792
    m_Localized: "+50% de carga. Troque a qualquer momento da ca\xE7ada ou quando
      a bateria acabar."
    m_Metadata:
      m_Items: []
  - m_Id: 1146486793
    m_Localized: AMPLIFICADOR EMF
    m_Metadata:
      m_Items: []
  - m_Id: 1146486794
    m_Localized: "O EMF alcan\xE7a 50% mais longe e uma seta aponta para a fonte.
      Uma ca\xE7ada."
    m_Metadata:
      m_Items: []
  - m_Id: 1146486795
    m_Localized: LENTE DE FOCO
    m_Metadata:
      m_Items: []
  - m_Id: 1146486796
    m_Localized: "A Lente Fantasma gasta metade da bateria. Uma ca\xE7ada."
    m_Metadata:
      m_Items: []
  - m_Id: 1146486797
    m_Localized: LINHA DE SAL
    m_Metadata:
      m_Items: []
  - m_Id: 1146486798
    m_Localized: "Fantasmas se movem 35% mais devagar sobre ch\xE3o com sal. Uma
      ca\xE7ada."
    m_Metadata:
      m_Items: []
  - m_Id: 4473458026479616
    m_Localized: "VERS\xC3O COMPLETA"
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451136
    m_Localized: "Sem an\xFAncios, recompensas de v\xEDdeo na hora, +1.500 de ectoplasma
      e laser dourado A0 AURUM."
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451137
    m_Localized: KIT DE NOVATO
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451138
    m_Localized: "1.000 de ectoplasma, laser T3 AMARRA, 3 de cada refor\xE7o e 3
      baterias reserva."
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451139
    m_Localized: FRASCO DE ECTOPLASMA
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451140
    m_Localized: 500 de ectoplasma para lasers e equipamentos.
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451141
    m_Localized: POTE DE ECTOPLASMA
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451142
    m_Localized: "1.800 de ectoplasma, b\xF4nus de +20% incluso."
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451143
    m_Localized: BARRIL DE ECTOPLASMA
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451144
    m_Localized: "3.500 de ectoplasma, b\xF4nus de +40% incluso."
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451145
    m_Localized: COFRE DE ECTOPLASMA
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451146
    m_Localized: "8.000 de ectoplasma, b\xF4nus de +60% incluso. A melhor oferta."
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451147
    m_Localized: KIT DE CAMPO
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451148
    m_Localized: "3 de cada refor\xE7o (amplificador EMF, lente, linha de sal) e
      3 baterias reserva."
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451149
    m_Localized: S5 ESPECTRO
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451150
    m_Localized: "Raio branco que fica ciano ao travar. Captura 30% mais r\xE1pido
      e freia o fantasma."
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451151
    m_Localized: S5 ESPECTRO
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451152
    m_Localized: "Feixe branco que trava em ciano. Captura 30% mais r\xE1pido e freia
      o fantasma preso."
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451153
    m_Localized: A0 AURUM
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451154
    m_Localized: "O feixe dourado da vers\xE3o completa: captura 35% mais r\xE1pido,
      anel mais largo, queda mais lenta."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
