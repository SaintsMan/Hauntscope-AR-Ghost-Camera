      m_Items: []
  - m_Id: 409467331411968
    m_Localized: FANTASMA INTEIRO
    m_Metadata:
      m_Items: []
  - m_Id: 415100688531456
    m_Localized: PROVAS
    m_Metadata:
      m_Items: []
  - m_Id: 415100722085888
    m_Localized: "Ainda n\xE3o h\xE1 fotos no arquivo. Fotografe-o com a c\xE2mera
      espiritual: uma foto com {0}+ estrelas vira prova (at\xE9 {1} por arquivo)."
    m_Metadata:
      m_Items: []
  - m_Id: 415100722085889
    m_Localized: 'Fotos no arquivo: {0}. Melhor foto: {1}/3 estrelas. Toque na foto
      para abri-la.'
    m_Metadata:
      m_Items: []
  - m_Id: 415100722085890
    m_Localized: 'Contam para desclassificar: {0}/{1} (fotos com {2}+ estrelas).'
