    m_Metadata:
      m_Items: []
  - m_Id: 400948809039881
    m_Localized: "Um fantasma no meu quarto: {0}! Flagrado na c\xE2mera com o Hauntscope.
      {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 400948809039882
