  - m_Id: 457669686460421
    m_Localized: '{0}/{1}'
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460422
    m_Localized: +{0}
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460423
    m_Localized: "{0} \xD7{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460424
    m_Localized: bezahlt
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460425
    m_Localized: ABHOLEN
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460426
    m_Localized: TAUSCHEN
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460427
    m_Localized: ERLEDIGT
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460428
    m_Localized: BEZAHLT
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460429
    m_Localized: "Neue Auftr\xE4ge in {0:00}:{1:00}:{2:00}"
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460430
    m_Localized: "Ein Tausch pro Tag ist gratis, ein weiterer gegen Werbung. Erledigte,
      aber nicht abgeholte Auftr\xE4ge werden um Mitternacht trotzdem bezahlt."
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460431
    m_Localized: AUFTRAG ERLEDIGT
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460432
    m_Localized: "AUFTR\xC4GE ERLEDIGT: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460433
    m_Localized: "Die Belohnung wartet unter AUFTR\xC4GE"
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460434
    m_Localized: "Fange Geister \xD7{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460435
    m_Localized: "Sammle Funde im Raum \xD7{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460436
    m_Localized: "Mach Fotos mit 1 Stern oder mehr \xD7{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460437
    m_Localized: "Halte den Strahl auf einen bet\xE4ubten Geist \xD7{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460438
    m_Localized: Mach ein 3-Sterne-Foto
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460439
    m_Localized: Treib einen Geist aus seinem Versteck
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460440
    m_Localized: Fange einen Geist aus weniger als 1 m
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460441
    m_Localized: Heb einen verfluchten Koffer auf (nur in der Linse)
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460442
    m_Localized: Fange einen Geist ohne Ersatzakku und Booster
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460443
    m_Localized: Fange einen Geist mit 50% Ladung oder mehr
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460444
    m_Localized: Erreiche den 3. Geist einer Nachtschicht
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460445
    m_Localized: 'Fange: {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460446
    m_Localized: Fange einen Geist in 1:30 oder schneller
    m_Metadata:
      m_Items: []
  - m_Id: 462155494588416
    m_Localized: TAGESRATION
    m_Metadata:
      m_Items: []
  - m_Id: 462155528142848
    m_Localized: '{0}'
    m_Metadata:
      m_Items: []
  - m_Id: 462155528142849
    m_Localized: Bild {0} von {1}
    m_Metadata:
      m_Items: []
  - m_Id: 462155528142850
    m_Localized: "Ein verpasster Tag spult das Band nie zur\xFCck"
    m_Metadata:
      m_Items: []
  - m_Id: 462155528142851
    m_Localized: "Das n\xE4chste Bild gibt es morgen"
    m_Metadata:
      m_Items: []
  - m_Id: 462155528142852
    m_Localized: ABHOLEN
    m_Metadata:
      m_Items: []
  - m_Id: 462155528142853
    m_Localized: ABGEHOLT
    m_Metadata:
      m_Items: []
  - m_Id: 462155528142854
    m_Localized: "\xD7{0} F\xDCR WERBUNG"
    m_Metadata:
      m_Items: []
  - m_Id: 462155528142855
    m_Localized: '{0}'
    m_Metadata:
      m_Items: []
  - m_Id: 462155528142856
    m_Localized: "\xD7{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 465765972443136
    m_Localized: "Er rei\xDFt sich los! Behalte ihn im Ring, lass nicht los."
    m_Metadata:
      m_Items: []
  - m_Id: 465766005997568
    m_Localized: AGENTEN-TIPP
    m_Metadata:
      m_Items: []
  - m_Id: 465766005997569
    m_Localized: "Sein Trick hat ihn bet\xE4ubt: Triff ihn jetzt mit dem Strahl!"
    m_Metadata:
      m_Items: []
  - m_Id: 465766005997570
    m_Localized: "Geh n\xE4her ran: Aus der N\xE4he l\xE4dt der Strahl viel schneller."
    m_Metadata:
      m_Items: []
  - m_Id: 465766005997571
    m_Localized: "Er ist in der Linse: Mach ein Foto f\xFCr seine Akte."
    m_Metadata:
      m_Items: []
  - m_Id: 465766005997572
    m_Localized: "Kalter Fleck: Er versteckt sich in der N\xE4he. Geh um die M\xF6bel
      herum und komm n\xE4her."
    m_Metadata:
      m_Items: []
  - m_Id: 465766005997573
    m_Localized: 'Beweg dich nicht: Sie kommt von selbst zu dir.'
    m_Metadata:
      m_Items: []
  - m_Id: 465766005997574
    m_Localized: "Geisterstunde: Seltene Geister kommen \xF6fter und jeder Fang bringt
      mehr."
    m_Metadata:
      m_Items: []
  - m_Id: 465766005997575
    m_Localized: "Jeder Bonus gilt bis zum Schichtende und addiert sich mit den anderen.
      W\xE4hle f\xFCr den n\xE4chsten Geist."
    m_Metadata:
      m_Items: []
  - m_Id: 465766005997576
    m_Localized: NEU
    m_Metadata:
      m_Items: []
  - m_Id: 465766005997577
    m_Localized: "TIPPS ZUR\xDCCKSETZEN"
    m_Metadata:
      m_Items: []
  - m_Id: 465766005997578
    m_Localized: TIPPS ERSCHEINEN WIEDER
    m_Metadata:
      m_Items: []
