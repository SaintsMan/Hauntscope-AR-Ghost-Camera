      m_Items: []
  - m_Id: 448606265278475
    m_Localized: "PAUSE \xB7 SCHICHT {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278476
    m_Localized: "W\xE4hle eins. Boni gelten bis zum Schichtende und addieren sich."
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278477
    m_Localized: "Akku {0}% \xB7 n\xE4chster Geist ist z\xE4her, Fang \xD7{1:0.#}"
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278478
    m_Localized: IN DIESER SCHICHT
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278479
    m_Localized: Kalte Linse
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278480
    m_Localized: Die Linse verbraucht nur halb so viel Akku.
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278481
    m_Localized: "Verst\xE4rkte Antenne"
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278482
    m_Localized: Das EMF reicht 50% weiter und zeigt auf den Geist.
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278483
    m_Localized: Harte Hand
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278484
    m_Localized: "Der Strahl f\xE4ngt 25% schneller."
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278485
    m_Localized: Breiter Strahl
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278486
    m_Localized: Der Fangring ist 30% breiter.
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278487
    m_Localized: Salz in der Tasche
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278488
    m_Localized: Geister bewegen sich 20% langsamer.
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278489
    m_Localized: Frischer Akku
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278490
    m_Localized: +40% Ladung sofort.
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278491
    m_Localized: Ersatzkassette
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278492
    m_Localized: +2 Bilder Film in jeder restlichen Jagd der Schicht.
    m_Metadata:
      m_Items: []
  - m_Id: 457669652905984
    m_Localized: "AUFTR\xC4GE"
    m_Metadata:
      m_Items: []
  - m_Id: 457669686460416
