  - m_Id: 448606227529728
    m_Localized: "NACHTSCHICHT \xB7 3 GEISTER"
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278464
    m_Localized: "Verf\xFCgbar nach {0} Jagden"
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278465
    m_Localized: 'Rekord: {0}/{1}'
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278466
    m_Localized: "SCHICHT {0}/{1} \xB7 \xD7{2:0.#}"
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278467
    m_Localized: WEITER
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278468
    m_Localized: NEUE SCHICHT
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278469
    m_Localized: "SCHICHT \xD7{0:0.#} +{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278470
    m_Localized: "NACHTSCHICHT {0}/{1} \xB7 SCHICHT GESAMT +{2}"
    m_Metadata:
      m_Items: []
  - m_Id: 448606265278471
    m_Localized: "SCHICHT BEENDET {0}/{0} \xB7 SCHICHT GESAMT +{1}"
