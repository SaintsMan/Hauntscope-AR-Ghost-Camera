  - m_Id: 668078062305284
    m_Localized: HINTER DIR
    m_Metadata:
      m_Items: []
  - m_Id: 668078062305285
    m_Localized: NAH
    m_Metadata:
      m_Items: []
  - m_Id: 668078062305286
    m_Localized: WEIT
    m_Metadata:
      m_Items: []
  - m_Id: 668078062305287
    m_Localized: VERSTECKT
    m_Metadata:
      m_Items: []
  - m_Id: 668078062305288
    m_Localized: "Die Agentur hat dir eine Spirit Box gegeben: Schalte sie ein und
      h\xF6r zu. Die Stimme verr\xE4t, wo der Geist ist."
    m_Metadata:
      m_Items: []
  - m_Id: 674327017422848
    m_Localized: MODUS
    m_Metadata:
      m_Items: []
  - m_Id: 674327084531712
    m_Localized: NACHTSICHT
    m_Metadata:
      m_Items: []
  - m_Id: 674327084531713
    m_Localized: 'Die Agentur hat dir Nachtsicht gegeben: Tippe auf MODUS. Du siehst
      den Geist schwach, ohne ihn sichtbar zu machen, und er bemerkt dich nicht.'
    m_Metadata:
      m_Items: []
