  - m_Id: 400948809039875
    m_Localized: "AKTE #{0:00} \xB7 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 400948809039876
    m_Localized: "HAUNTSCOPE \xB7 AR-GEISTERKAMERA"
    m_Metadata:
      m_Items: []
  - m_Id: 400948809039877
    m_Localized: TEILEN
    m_Metadata:
      m_Items: []
  - m_Id: 400948809039878
    m_Localized: IN GALERIE SPEICHERN
    m_Metadata:
      m_Items: []
  - m_Id: 400948809039879
    m_Localized: IN GALERIE GESPEICHERT
    m_Metadata:
      m_Items: []
  - m_Id: 400948809039880
    m_Localized: SPEICHERN FEHLGESCHLAGEN
    m_Metadata:
      m_Items: []
  - m_Id: 400948809039881
    m_Localized: 'Ein Geist in meinem Zimmer: {0}! Mit Hauntscope vor die Kamera
      bekommen. {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 400948809039882
    m_Localized: Teile den Beweis
    m_Metadata:
      m_Items: []
  - m_Id: 400948809039883
    m_Localized: FOTO +{0}
    m_Metadata:
      m_Items: []
  - m_Id: 409467331411968
    m_Localized: GANZER GEIST
    m_Metadata:
      m_Items: []
  - m_Id: 415100688531456
    m_Localized: BEWEISE
    m_Metadata:
      m_Items: []
  - m_Id: 415100722085888
    m_Localized: 'Noch keine Fotos in der Akte. Fotografiere ihn mit der Geisterkamera:
      Ein Foto mit {0}+ Sternen wird zum Beweis (bis zu {1} pro Akte).'
    m_Metadata:
      m_Items: []
  - m_Id: 415100722085889
    m_Localized: "Fotos in der Akte: {0}. Bestes Foto: {1}/3 Sterne. Tippe auf den
      Abzug, um es zu \xF6ffnen."
    m_Metadata:
      m_Items: []
  - m_Id: 415100722085890
    m_Localized: "Z\xE4hlt zur Freigabe: {0}/{1} (Fotos mit {2}+ Sternen)."
    m_Metadata:
      m_Items: []
  - m_Id: 415100722085891
    m_Localized: "\xD7{0}"
