  m_TableData:
  - m_Id: 1129709568
    m_Localized: "M1 \u0421\u0422\u0410\u041D\u0414\u0410\u0420\u0422"
    m_Metadata:
      m_Items: []
  - m_Id: 1146486784
    m_Localized: "\u0421\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u0438\u0439
      \u0432\u0438\u0434\u0430\u0442\u043E\u043A \u0430\u0433\u0435\u043D\u0446\u0456\u0457.
      \u041D\u0430\u0434\u0456\u0439\u043D\u0438\u0439 \u2014 \u0456 \u043D\u0435
      \u0431\u0456\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1146486785
    m_Localized: "W2 \u041F\u0420\u041E\u0416\u0415\u041A\u0422\u041E\u0420"
    m_Metadata:
      m_Items: []
  - m_Id: 1146486786
    m_Localized: "\u0428\u0438\u0440\u043E\u043A\u0435 \u043A\u0456\u043B\u044C\u0446\u0435
      \u043F\u0440\u043E\u0449\u0430\u0454 \u0442\u0440\u0435\u043C\u0442\u0456\u043D\u043D\u044F
      \u0440\u0443\u043A\u0438. \u0417\u0430\u0445\u043E\u043F\u043B\u0435\u043D\u043D\u044F
      \u0441\u043F\u0430\u0434\u0430\u0454 \u0432\u0434\u0432\u0456\u0447\u0456 \u043F\u043E\u0432\u0456\u043B\u044C\u043D\u0456\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1146486787
    m_Localized: "T3 \u041F\u0420\u0418\u0412\u2019\u042F\u0417\u042C"
    m_Metadata:
      m_Items: []
  - m_Id: 1146486788
    m_Localized: "\u0422\u0440\u0438\u043C\u0430\u0454 \u043F\u0440\u0438\u0432\u0438\u0434\u0430:
      \u0443 \u043F\u0440\u043E\u043C\u0435\u043D\u0456 \u0432\u0434\u0432\u0456\u0447\u0456
      \u043F\u043E\u0432\u0456\u043B\u044C\u043D\u0456\u0448\u0438\u0439, \u0437\u0430\u0445\u043E\u043F\u043B\u0435\u043D\u043D\u044F
      +20%."
    m_Metadata:
      m_Items: []
  - m_Id: 1146486789
    m_Localized: "P4 \u0424\u0410\u0417\u041E\u0412\u0418\u0419 \u0421\u041F\u0418\u0421"
    m_Metadata:
      m_Items: []
  - m_Id: 1146486790
    m_Localized: "\u0417\u0430\u0445\u043E\u043F\u043B\u044E\u0454 \u043D\u0430 60%
      \u0448\u0432\u0438\u0434\u0448\u0435 \u0439 \u0442\u0440\u0438\u043C\u0430\u0454
      \u043F\u0440\u0438\u0432\u0438\u0434\u0430, \u0449\u043E \u0437\u043D\u0438\u043A\u0430\u0454.
      \u0412\u0443\u0437\u044C\u043A\u0435 \u043A\u0456\u043B\u044C\u0446\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1146486791
    m_Localized: "\u0417\u0410\u041F\u0410\u0421\u041D\u0410 \u0411\u0410\u0422\u0410\u0420\u0415\u042F"
    m_Metadata:
      m_Items: []
  - m_Id: 1146486792
    m_Localized: "+50% \u0437\u0430\u0440\u044F\u0434\u0443. \u0412\u0441\u0442\u0430\u0432
      \u0431\u0443\u0434\u044C-\u043A\u043E\u043B\u0438 \u043F\u0456\u0434 \u0447\u0430\u0441
      \u043F\u043E\u043B\u044E\u0432\u0430\u043D\u043D\u044F \u0430\u0431\u043E \u043A\u043E\u043B\u0438
      \u0431\u0430\u0442\u0430\u0440\u0435\u044F \u0441\u044F\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1146486793
    m_Localized: "EMF-\u041F\u0406\u0414\u0421\u0418\u041B\u042E\u0412\u0410\u0427"
    m_Metadata:
      m_Items: []
  - m_Id: 1146486794
    m_Localized: "EMF \u0431\u0430\u0447\u0438\u0442\u044C \u043D\u0430 50% \u0434\u0430\u043B\u0456,
      \u0430 \u0441\u0442\u0440\u0456\u043B\u043A\u0430 \u0432\u043A\u0430\u0437\u0443\u0454
      \u043D\u0430 \u0434\u0436\u0435\u0440\u0435\u043B\u043E. \u041D\u0430 \u043E\u0434\u043D\u0435
      \u043F\u043E\u043B\u044E\u0432\u0430\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1146486795
    m_Localized: "\u0424\u041E\u041A\u0423\u0421\u041D\u0410 \u041B\u0406\u041D\u0417\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 1146486796
    m_Localized: "\u041B\u0456\u043D\u0437\u0430 \u0432\u0438\u0442\u0440\u0430\u0447\u0430\u0454
      \u0432\u0434\u0432\u0456\u0447\u0456 \u043C\u0435\u043D\u0448\u0435 \u0437\u0430\u0440\u044F\u0434\u0443.
      \u041D\u0430 \u043E\u0434\u043D\u0435 \u043F\u043E\u043B\u044E\u0432\u0430\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 1146486797
    m_Localized: "\u0421\u041E\u041B\u042F\u041D\u0410 \u041B\u0406\u041D\u0406\u042F"
    m_Metadata:
      m_Items: []
  - m_Id: 1146486798
    m_Localized: "\u041D\u0430\u0434 \u043F\u043E\u0441\u0438\u043F\u0430\u043D\u043E\u044E
      \u043F\u0456\u0434\u043B\u043E\u0433\u043E\u044E \u043F\u0440\u0438\u0432\u0438\u0434\u0438
      \u043D\u0430 35% \u043F\u043E\u0432\u0456\u043B\u044C\u043D\u0456\u0448\u0456.
      \u041D\u0430 \u043E\u0434\u043D\u0435 \u043F\u043E\u043B\u044E\u0432\u0430\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
