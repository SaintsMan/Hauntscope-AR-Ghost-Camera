  m_TableData:
  - m_Id: 1129709568
    m_Localized: "M1 EST\xC1NDAR"
    m_Metadata:
      m_Items: []
  - m_Id: 1146486784
    m_Localized: "Equipo est\xE1ndar de la agencia. Confiable, y nada m\xE1s."
    m_Metadata:
      m_Items: []
  - m_Id: 1146486785
    m_Localized: W2 REFLECTOR
    m_Metadata:
      m_Items: []
  - m_Id: 1146486786
    m_Localized: Un anillo ancho que perdona el pulso tembloroso. La captura se desvanece
      a la mitad de velocidad.
    m_Metadata:
      m_Items: []
  - m_Id: 1146486787
    m_Localized: T3 AMARRE
    m_Metadata:
      m_Items: []
  - m_Id: 1146486788
    m_Localized: 'Sujeta al fantasma: mitad de velocidad en el rayo, captura +20%.'
    m_Metadata:
      m_Items: []
  - m_Id: 1146486789
    m_Localized: P4 LANZA DE FASE
    m_Metadata:
      m_Items: []
  - m_Id: 1146486790
    m_Localized: "Captura un 60% m\xE1s r\xE1pido y retiene a los fantasmas que desaparecen.
      Anillo estrecho."
    m_Metadata:
      m_Items: []
  - m_Id: 1146486791
    m_Localized: "BATER\xCDA DE REPUESTO"
    m_Metadata:
      m_Items: []
  - m_Id: 1146486792
    m_Localized: "+50% de carga. \xDAsala en cualquier momento de la cacer\xEDa o
      cuando se agote la bater\xEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 1146486793
    m_Localized: AMPLIFICADOR EMF
    m_Metadata:
      m_Items: []
  - m_Id: 1146486794
    m_Localized: "El EMF llega un 50% m\xE1s lejos y una flecha se\xF1ala la fuente.
      Una cacer\xEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 1146486795
    m_Localized: LENTE DE ENFOQUE
    m_Metadata:
      m_Items: []
  - m_Id: 1146486796
    m_Localized: "La Lente Fantasma gasta la mitad de bater\xEDa. Una cacer\xEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 1146486797
    m_Localized: "L\xCDNEA DE SAL"
    m_Metadata:
      m_Items: []
  - m_Id: 1146486798
    m_Localized: "Los fantasmas se mueven un 35% m\xE1s lento sobre el piso con sal.
      Una cacer\xEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 4473458026479616
    m_Localized: "VERSI\xD3N COMPLETA"
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451136
    m_Localized: "Sin anuncios, premios de video al instante, +1500 de ectoplasma
      y l\xE1ser dorado A0 AURUM."
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451137
    m_Localized: KIT DE NOVATO
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451138
    m_Localized: "1000 de ectoplasma, l\xE1ser T3 AMARRE, 3 de cada potenciador y
      3 bater\xEDas de repuesto."
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451139
    m_Localized: FRASCO DE ECTOPLASMA
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451140
    m_Localized: "500 de ectoplasma para l\xE1seres y equipo."
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451141
    m_Localized: TARRO DE ECTOPLASMA
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451142
    m_Localized: 1800 de ectoplasma, bono del +20% incluido.
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451143
    m_Localized: BARRIL DE ECTOPLASMA
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451144
    m_Localized: 3500 de ectoplasma, bono del +40% incluido.
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451145
    m_Localized: "B\xD3VEDA DE ECTOPLASMA"
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451146
    m_Localized: "8000 de ectoplasma, bono del +60% incluido. La mejor opci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451147
    m_Localized: KIT DE CAMPO
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451148
    m_Localized: "3 de cada potenciador (amplificador EMF, lente, l\xEDnea de sal)
      y 3 bater\xEDas de repuesto."
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451149
    m_Localized: S5 ESPECTRO
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451150
    m_Localized: "Rayo blanco que se vuelve cian al fijar. Captura un 30% m\xE1s
      r\xE1pido y frena al fantasma."
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451151
    m_Localized: S5 ESPECTRO
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451152
    m_Localized: "Rayo blanco que se fija en cian. Captura un 30% m\xE1s r\xE1pido
      y frena al fantasma atrapado."
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451153
    m_Localized: A0 AURUM
    m_Metadata:
      m_Items: []
  - m_Id: 4473458047451154
    m_Localized: "El rayo dorado de la versi\xF3n completa: captura un 35% m\xE1s
      r\xE1pido, aro m\xE1s ancho, cae m\xE1s lento."
    m_Metadata:
      m_Items: []
  references:
    version: 2
